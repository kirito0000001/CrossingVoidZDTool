                                            x:Name="SequenceOuterPreviewFpsStepper"
                                            Grid.Column="1"
                                            Width="120"
                                            Maximum="60"
                                            Minimum="1"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding SequenceFrames.PreviewFps, Mode=TwoWay}"
                                            ValueChanged="SequencePreviewFpsNumberBox_ValueChanged" />
                                        <Button
                                            Grid.Column="2"
                                            Click="PreviousSequenceFrameButton_Click"
                                            Style="{StaticResource IconToolButtonStyle}"
                                            ToolTipService.ToolTip="上一帧">
                                            <FontIcon Glyph="&#xE892;" />
                                        </Button>
                                        <Button
                                            Grid.Column="3"
                                            Click="PlayPauseSequencePreviewButton_Click"
                                            Style="{StaticResource IconToolButtonStyle}"
                                            ToolTipService.ToolTip="{Binding SequenceFrames.PlayPauseToolTip, Mode=OneWay}">
                                            <FontIcon Glyph="{Binding SequenceFrames.PlayPauseGlyph, Mode=OneWay}" />
                                        </Button>
                                        <Button
                                            Grid.Column="4"
                                            Click="NextSequenceFrameButton_Click"
                                            Style="{StaticResource IconToolButtonStyle}"
                                            ToolTipService.ToolTip="下一帧">
                                            <FontIcon Glyph="&#xE893;" />
                                        </Button>
                                        <Button
                                            Grid.Column="5"
                                            Click="OpenSequenceEditorButton_Click"
                                            Content="编辑帧序列"
                                            Style="{StaticResource PrimaryToolButtonStyle}" />
                                        <Button Grid.Column="6" Click="OpenSequenceCollectionButton_Click" Content="帧素材合集" Style="{StaticResource PrimaryToolButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="BuffsPage"
                    Grid.Row="0"

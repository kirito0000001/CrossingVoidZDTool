<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CrossingVoidZDTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="零境 ZD 角色制作工具箱"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="18,0,170,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" VerticalAlignment="Center" CornerRadius="7">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="零境 ZD 角色制作工具箱"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="1.0.0" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            CompactPaneLength="64"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            OpenPaneLength="286"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ShellNavigation_SelectionChanged"
            SelectionFollowsFocus="Disabled">
            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">64</x:Double>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="CharacterDeskNavItem"
                    Content="零境角色台"
                    IsSelected="True"
                    Tag="CharacterDesk">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="动作帧" Tag="ActionFrames">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="线稿处理" Tag="LineArt">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Edit" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="虚幻同步" Tag="UnrealSync">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sync" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="GlobalSettingsNavItem" Content="整体设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="CharacterDeskPage"
                    RowSpacing="14"
                    Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="零境角色台" />
                            <TextBlock
                                Style="{StaticResource SubtleTextStyle}"
                                Text="角色制作入口占位页。后续会从这里进入角色、动作、帧处理和导出流程。" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="新建角色">
                            <SymbolIcon Symbol="Add" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="刷新工作区">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                        <Grid Padding="24">
                            <StackPanel
                                Width="520"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Spacing="12">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="空白占位" />
                                <TextBlock
                                    Style="{StaticResource SubtleTextStyle}"
                                    Text="这里先保留为空白工作台。后续接入角色列表、动作集、序列帧和线稿处理模块时，按 Docs/MvvmAndUxGuidelines.md 的规则逐页补齐。" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="WorkspaceStatusBorder" Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <Grid Padding="14,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="WorkspaceStatusText"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding CharacterDesk.StatusText, Mode=OneWay}" />
                            <ProgressBar
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsIndeterminate="False"
                                Value="0" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    x:Name="ActionFramesPage"
                    Grid.Row="0"
                    Visibility="Collapsed">
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Padding="24" Spacing="8">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="动作帧" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="占位页。之后接入截图序列导入、帧序检查、裁切和关键帧标记。" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid
                    x:Name="LineArtPage"
                    Grid.Row="0"
                    Visibility="Collapsed">
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Padding="24" Spacing="8">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="线稿处理" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="占位页。之后接入批量边线提取、线稿预览和输出管理。" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid
                    x:Name="UnrealSyncPage"
                    Grid.Row="0"
                    Visibility="Collapsed">
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Padding="24" Spacing="8">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="虚幻同步" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="占位页。之后接入角色素材、动作帧和 Unreal 目标目录同步。" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ScrollViewer
                    x:Name="SettingsPage"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
                    <Grid
                        MaxWidth="1120"
                        HorizontalAlignment="Left"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="10">
                            <StackPanel Spacing="4" Margin="0,0,0,2">
                                <TextBlock Text="整体设置" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="这些设置影响所有角色项目。程序启动时会先检查整体项目位置，不存在则自动创建。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>

                            <Border HorizontalAlignment="Stretch" Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="16" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="整体项目位置" Style="{StaticResource SectionTitleStyle}" />
                                        <Button
                                            Style="{StaticResource HelpIconButtonStyle}"
                                            Click="ShowProjectRootHelpButton_Click"
                                            ToolTipService.ToolTip="查看整体项目位置说明">
                                            <FontIcon FontSize="15" Glyph="&#xE11B;" />
                                        </Button>
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ProjectRootPathTextBox"
                                            Header="文件目录"
                                            IsReadOnly="True"
                                            Text="{Binding Settings.ProjectRootPath, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="0,28,0,0"
                                            Content="选择位置"
                                            Click="ChooseProjectRootButton_Click"
                                            ToolTipService.ToolTip="选择父目录，程序会自动在其中创建 CrossingVoidZDProject 文件夹。" />
                                    </Grid>
                                    <InfoBar
                                        x:Name="ProjectRootStatusInfoBar"
                                        IsOpen="True"
                                        Message="{Binding Settings.ProjectRootStatusMessage, Mode=OneWay}"
                                        Severity="{Binding Settings.ProjectRootStatusSeverity, Mode=OneWay}"
                                        Title="{Binding Settings.ProjectRootStatusTitle, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Expander>
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="辅助显示" Style="{StaticResource SectionTitleStyle}" />
                                        <Button
                                            Style="{StaticResource HelpIconButtonStyle}"
                                            Click="ShowLogHelpButton_Click"
                                            ToolTipService.ToolTip="查看辅助显示说明">
                                            <FontIcon FontSize="15" Glyph="&#xE11B;" />
                                        </Button>
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel Padding="18" Spacing="0">
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示工作区路径" VerticalAlignment="Center" />
                                        <CheckBox
                                            x:Name="WorkspacePathVisibleCheckBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.ShowWorkspacePath, Mode=TwoWay}"
                                            Checked="LogSettingControl_Changed"
                                            Unchecked="LogSettingControl_Changed" />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="开启 log 功能" VerticalAlignment="Center" />
                                        <CheckBox
                                            x:Name="LogEnabledCheckBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.LogEnabled, Mode=TwoWay}"
                                            Checked="LogSettingControl_Changed"
                                            Unchecked="LogSettingControl_Changed" />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="log 输出用户操作" VerticalAlignment="Center" />
                                        <CheckBox
                                            x:Name="LogUserOperationsCheckBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.LogUserOperations, Mode=TwoWay}"
                                            Checked="LogSettingControl_Changed"
                                            Unchecked="LogSettingControl_Changed" />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="log 输出提示" VerticalAlignment="Center" />
                                        <CheckBox
                                            x:Name="LogWarningCheckBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.LogWarnings, Mode=TwoWay}"
                                            Checked="LogSettingControl_Changed"
                                            Unchecked="LogSettingControl_Changed" />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="log 输出错误提示" VerticalAlignment="Center" />
                                        <CheckBox
                                            x:Name="LogErrorCheckBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.LogErrors, Mode=TwoWay}"
                                            Checked="LogSettingControl_Changed"
                                            Unchecked="LogSettingControl_Changed" />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="撤回上一次设置修改" VerticalAlignment="Center" />
                                            <TextBlock
                                                Style="{StaticResource SubtleTextStyle}"
                                                Text="{Binding Settings.SettingUndoStatusText, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            MinWidth="96"
                                            VerticalAlignment="Center"
                                            Command="{Binding Settings.UndoLastSettingCommand}"
                                            Content="撤回"
                                            ToolTipService.ToolTip="撤回最近一次设置开关修改。" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PanelBorderStyle}">
                            <StackPanel Padding="16" Spacing="12">
                                <Border Width="86" Height="86" CornerRadius="16" HorizontalAlignment="Left">
                                    <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" FontSize="20" />
                                    <TextBlock Text="零境 ZD 角色制作工具箱" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" />
                                    <TextBlock Text="版本 1.0.0" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Text="面向零境 ZD 角色动作帧、线稿辅助、素材规范和 Unreal 对接的制作工具箱。"
                                    Style="{StaticResource SubtleTextStyle}" />
                                <StackPanel Spacing="8">
                                    <TextBlock Text="版本命名" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock
                                        Text="采用 主版本.功能版本.修订版本。1.0.0 表示当前进入第一个可维护基线版本。"
                                        Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="制作人员" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="企划 / 使用设计：柳雨" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Text="程序协作：Codex" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="LogPanelBorder" Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输出日志" Style="{StaticResource SectionTitleStyle}" />
                            <Button Grid.Column="1" Content="清空" Click="ClearLogButton_Click" />
                        </Grid>
                        <ScrollViewer
                            x:Name="LogScrollViewer"
                            Grid.Row="1"
                            MaxHeight="150"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogItemsControl" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>

        <Border
            x:Name="GlobalProgressHost"
            Grid.RowSpan="2"
            MaxWidth="1540"
            Margin="28"
            Padding="22,18"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="100"
            Background="#E6FFFFFF"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0"
            RenderTransformOrigin="0.5,1"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="GlobalProgressHostTransform" Y="130" />
            </Border.RenderTransform>
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="10" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="当前进度:"
                            Foreground="#202020"
                            FontSize="24"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="GlobalProgressTitleText"
                            Grid.Column="1"
                            Foreground="#202020"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="{Binding GlobalProgress.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                Text="用时:"
                                Foreground="#202020"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="GlobalProgressElapsedText"
                                Foreground="#202020"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Text="{Binding GlobalProgress.ElapsedText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar
                        x:Name="GlobalProgressBar"
                        Grid.Row="1"
                        Height="11"
                        Minimum="0"
                        Maximum="100"
                        Foreground="#008F8D"
                        Background="#1A008F8D"
                        IsIndeterminate="{Binding GlobalProgress.IsIndeterminate, Mode=OneWay}"
                        Value="{Binding GlobalProgress.Percent, Mode=OneWay}" />

                    <TextBlock
                        x:Name="GlobalProgressDetailText"
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding GlobalProgress.Detail, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid
                    x:Name="GlobalProgressRing"
                    Grid.Column="1"
                    Width="86"
                    Height="86"
                    Background="Transparent"
                    Tapped="GlobalProgressRing_Tapped"
                    ToolTipService.ToolTip="取消当前操作">
                    <Ellipse
                        Stroke="#22008F8D"
                        StrokeThickness="7" />
                    <Path
                        x:Name="GlobalProgressRingPath"
                        Stroke="#008F8D"
                        StrokeThickness="7"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                    <TextBlock
                        x:Name="GlobalProgressPercentText"
                        Foreground="#008F8D"
                        FontSize="24"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        LineHeight="28"
                        Text="{Binding GlobalProgress.PercentText, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

                                                        Visibility="{Binding UnrealProjectSync.WorkflowNextButtonVisibility, Mode=OneWay}"
                                                        Style="{StaticResource AccentButtonStyle}" />
                                                 </Grid>
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Click="UnrealSyncDetectAllStepsButton_Click"

                                                Grid.Column="1"
                                                Click="DecreaseStatButton_Click"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconToolButtonStyle}">
                                                <SymbolIcon Symbol="Back" />
                                            </Button>
                                            <NumberBox
                                                Grid.Column="2"
                                                Width="96"
                                                HorizontalAlignment="Center"
                                                KeyDown="StatNumberBox_KeyDown"
                                                LostFocus="StatNumberBox_LostFocus"
                                                Minimum="1"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Hidden"
                                                Value="{Binding Value, Mode=OneWay}" />
                                            <Button
                                                Grid.Column="3"
                                                Click="IncreaseStatButton_Click"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconToolButtonStyle}">
                                                <SymbolIcon Symbol="Forward" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <Grid Padding="16" ColumnSpacing="12">

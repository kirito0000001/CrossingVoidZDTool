                            </StackPanel>

                            <Border HorizontalAlignment="Stretch" Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="16" Spacing="12">
                                    <TextBlock Text="整体项目位置" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ProjectRootPathTextBox"
                                            Header="文件目录"
                                            IsReadOnly="True"
                                            Text="{Binding Settings.ProjectRootPath, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="0,28,0,0"
                                            Content="选择位置"
                                            Click="ChooseProjectRootButton_Click"
                                            ToolTipService.ToolTip="选择父目录，程序会自动在其中创建 CrossingVoidZDProject 文件夹。" />
                                    </Grid>
                                    <InfoBar
                                        x:Name="ProjectRootStatusInfoBar"
                                        IsOpen="True"
                                        Message="{Binding Settings.ProjectRootStatusMessage, Mode=OneWay}"
                                        Severity="{Binding Settings.ProjectRootStatusSeverity, Mode=OneWay}"
                                        Title="{Binding Settings.ProjectRootStatusTitle, Mode=OneWay}" />
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="同步前压缩备份 Unreal 项目" />
                                            <TextBlock FontSize="12" Style="{StaticResource SubtleTextStyle}" Text="执行同步前自动创建可恢复备份。" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{Binding Settings.BackupBeforeUnrealSync, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Expander>
                                <Expander.Header>
                                    <TextBlock Text="辅助显示" Style="{StaticResource SectionTitleStyle}" />
                                </Expander.Header>

                                <StackPanel Padding="18" Spacing="0">
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="夜晚模式" VerticalAlignment="Center" />
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsOn="{Binding Settings.NightModeEnabled, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示工作区路径" VerticalAlignment="Center" />
                                        <CheckBox
                                            x:Name="WorkspacePathVisibleCheckBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.ShowWorkspacePath, Mode=TwoWay}"
                                                                               
                                                                                  />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="开启 log 功能" VerticalAlignment="Center" />
                                        <CheckBox
                                            x:Name="LogEnabledCheckBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.LogEnabled, Mode=TwoWay}"
                                                                               
                                                                                  />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="log 输出用户操作" VerticalAlignment="Center" />
                                        <CheckBox
                                            x:Name="LogUserOperationsCheckBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.LogUserOperations, Mode=TwoWay}"
                                                                               
                                                                                  />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="log 输出提示" VerticalAlignment="Center" />
                                        <CheckBox
                                            x:Name="LogWarningCheckBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.LogWarnings, Mode=TwoWay}"
                                                                               
                                                                                  />
                                    </Grid>
                                    <Grid MinHeight="44" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="log 输出错误提示" VerticalAlignment="Center" />
                                        <CheckBox
                                            x:Name="LogErrorCheckBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding Settings.LogErrors, Mode=TwoWay}"
                                                                               
                                                                                  />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PanelBorderStyle}">
                            <StackPanel Padding="16" Spacing="12">
                                <Border Width="86" Height="86" CornerRadius="16" HorizontalAlignment="Left">
                                    <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" FontSize="20" />
                                    <TextBlock Text="零境交错：ZD工具箱" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" />
                                    <TextBlock Text="版本 1.0.0" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Text="面向零境 ZD 角色动作帧、线稿辅助、素材规范和 Unreal 对接的制作工具箱。"
                                    Style="{StaticResource SubtleTextStyle}" />
                                <StackPanel Spacing="8">
                                    <TextBlock Text="版本命名" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock
                                        Text="采用 主版本.功能版本.修订版本。1.0.0 表示当前进入第一个可维护基线版本。"
                                        Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="制作人员" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="企划 / 使用设计：柳雨" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Text="程序协作：Codex" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Border
                    x:Name="ProductionStatusBorder"
                    Grid.Row="1"
                    Style="{StaticResource PanelBorderStyle}">
                    <Grid Padding="10" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <InfoBar
                            IsOpen="{Binding ProductionStatus.IsOpen, Mode=OneWay}"
                            Message="{Binding ProductionStatus.Message, Mode=OneWay}"
                            Severity="{Binding ProductionStatus.Severity, Mode=OneWay}"
                            Title="{Binding ProductionStatus.Title, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            MinWidth="132"
                            Content="完成制作"
                            Click="CompleteCharacterButton_Click"
                            IsEnabled="{Binding ProductionStatus.CanComplete, Mode=OneWay}"
                            Style="{StaticResource PrimaryToolButtonStyle}" />
                    </Grid>
                </Border>

                <Border x:Name="LogPanelBorder" Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                    <Grid Padding="12,8,12,10" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输出日志" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button Click="ScrollLogToBottomButton_Click" Content="滚动到底部" />
                                <Button Click="CopyAllLogButton_Click" Content="复制全部" />
                                <Button Click="ClearLogButton_Click" Content="清空" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer
                            x:Name="LogScrollViewer"
                            Grid.Row="1"
                            MaxHeight="150"
                            HorizontalScrollBarVisibility="Auto"
                            PointerWheelChanged="LogScrollViewer_PointerWheelChanged"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                x:Name="LogItemsControl"
                                PointerWheelChanged="LogScrollViewer_PointerWheelChanged" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>

        <Border
            x:Name="GlobalProgressHost"
            Grid.RowSpan="2"
            MaxWidth="1540"
            Margin="28"
            Padding="22,18"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="320"
            Background="{ThemeResource GlobalProgressHostBackgroundBrush}"
            BorderBrush="{ThemeResource GlobalProgressHostBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0"
            RenderTransformOrigin="0.5,1"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="GlobalProgressHostTransform" Y="130" />
            </Border.RenderTransform>
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="10" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="当前进度:"
                            Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="GlobalProgressTitleText"
                            Grid.Column="1"
                            Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="{Binding GlobalProgress.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                Text="用时:"
                                Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="GlobalProgressElapsedText"
                                Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Text="{Binding GlobalProgress.ElapsedText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar
                        x:Name="GlobalProgressBar"
                        Grid.Row="1"
                        Height="11"
                        Minimum="0"
                        Maximum="100"
                        Foreground="#008F8D"
                        Background="#1A008F8D"
                        IsIndeterminate="{Binding GlobalProgress.IsIndeterminate, Mode=OneWay}"
                        Value="{Binding GlobalProgress.Percent, Mode=OneWay}" />

                    <TextBlock
                        x:Name="GlobalProgressDetailText"
                        Grid.Row="2"
                        Foreground="{ThemeResource GlobalProgressSecondaryTextBrush}"
                        Text="{Binding GlobalProgress.Detail, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid
                    x:Name="GlobalProgressRing"
                    Grid.Column="1"
                    Width="86"
                    Height="86"
                    Background="Transparent"
                    Tapped="GlobalProgressRing_Tapped"
                    ToolTipService.ToolTip="取消当前操作">
                    <Ellipse
                        Stroke="#22008F8D"
                        StrokeThickness="7" />
                    <Path
                        x:Name="GlobalProgressRingPath"
                        Stroke="#008F8D"
                        StrokeThickness="7"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                    <TextBlock
                        x:Name="GlobalProgressPercentText"
                        Foreground="#008F8D"
                        FontSize="24"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        LineHeight="28"
                        Text="{Binding GlobalProgress.PercentText, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel
            x:Name="FloatingTipsPanel"
            Grid.Row="1"
            MaxWidth="520"
            Margin="0,18,28,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Canvas.ZIndex="330"
            Spacing="6" />

        <Grid
            x:Name="BuffEditorHost"
            Grid.RowSpan="2"
            Background="#8C000000"
            Canvas.ZIndex="145"
            IsTabStop="True"
            KeyDown="BuffEditorHost_KeyDown"
            RightTapped="BuffEditorHost_RightTapped"
            Tapped="BuffEditorHost_Tapped"
            Visibility="Collapsed">
            <Border
                x:Name="BuffEditorCard"
                Width="1080"
                MaxHeight="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                RenderTransformOrigin="0.5,0.5"
                Tapped="BuffEditorCard_Tapped">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="BuffEditorCardScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="26,22,26,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="22"
                                FontWeight="SemiBold"
                                Text="{Binding Buffs.SelectedBuff.DisplayName, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding Buffs.SelectedBuff.GeneratedCode, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Click="BuffEditorCloseButton_Click"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="关闭">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Padding="26,0,26,18"
                        ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="BuffEditorIdentityPanel"
                            Spacing="12">
                            <Border
                                Width="180"
                                Height="180"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Image Source="{Binding Buffs.SelectedBuff.IconUri, Mode=OneWay}" Stretch="UniformToFill" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SubtleTextStyle}"
                                        Text="图标"
                                        Visibility="{Binding Buffs.SelectedBuff.HasNoIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    CommandParameter="{Binding Buffs.SelectedBuff, Mode=OneWay}"
                                    Click="ImportBuffIconButton_Click"
                                    Content="选择图标"
                                    HorizontalAlignment="Stretch" />
                                <Button
                                    Grid.Column="1"
                                    CommandParameter="{Binding Buffs.SelectedBuff, Mode=OneWay}"
                                    Click="UseDefaultBuffIconButton_Click"
                                    Content="恢复默认"
                                    HorizontalAlignment="Stretch" />
                            </Grid>
                            <Border
                                Height="1"
                                Margin="0,4"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="当前 BUFF" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding Buffs.SelectedBuff.DisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource SubtleTextStyle}"
                                    Text="{Binding Buffs.SelectedBuff.GeneratedCode, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource SubtleTextStyle}"
                                    Text="{Binding Buffs.SelectedBuff.EffectSummaryText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="归属角色" />
                                <TextBlock
                                    Text="{Binding Buffs.SelectedBuff.OwnerText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer
                            x:Name="BuffEditorPropertiesScrollViewer"
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Enabled">
                            <StackPanel Padding="0,0,12,0" Spacing="18">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="基础定义" />
                                    <Grid ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox
                                            Header="BUFF 名称"
                                            KeyDown="BuffTextBox_KeyDown"
                                            Text="{Binding Buffs.SelectedBuff.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Header="英文备注"
                                            KeyDown="BuffTextBox_KeyDown"
                                            Text="{Binding Buffs.SelectedBuff.UserCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Grid.Row="1" Spacing="6">
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="归属于谁" />
                                            <Border
                                                MinHeight="34"
                                                Padding="10,7"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <TextBlock
                                                    Text="{Binding Buffs.SelectedBuff.OwnerText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </StackPanel>
                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Header="触发时机"
                                            KeyDown="BuffTextBox_KeyDown"
                                            Text="{Binding Buffs.SelectedBuff.TriggerTiming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <StackPanel Spacing="10">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="数值与触发" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            Header="类型枚举"
                                            SelectedValue="{Binding Buffs.SelectedBuff.DamageType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Tag">
                                            <ComboBoxItem Content="无（仅标记）" Tag="" />
                                            <ComboBoxItem Content="发送方-属性" Tag="发送方-属性" />
                                            <ComboBoxItem Content="发送方-最终" Tag="发送方-最终" />
                                            <ComboBoxItem Content="接收方-属性" Tag="接收方-属性" />
                                            <ComboBoxItem Content="接收方-最终" Tag="接收方-最终" />
                                        </ComboBox>
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Header="增益/削弱"
                                            SelectedValue="{Binding Buffs.SelectedBuff.GainType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Content">
                                            <ComboBoxItem Content="增益" />
                                            <ComboBoxItem Content="削弱" />
                                        </ComboBox>
                                        <ComboBox
                                            Grid.Column="2"
                                            HorizontalAlignment="Stretch"
                                            Header="优先级"
                                            SelectedValue="{Binding Buffs.SelectedBuff.TaskPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Content">
                                            <ComboBoxItem Content="低" />
                                            <ComboBoxItem Content="正常" />
                                            <ComboBoxItem Content="高" />
                                            <ComboBoxItem Content="紧急" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="层数范围" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <NumberBox
                                                    Header="基础值"
                                                    Minimum="0"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{Binding Buffs.SelectedBuff.Stacks, Mode=TwoWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="0,30,0,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SubtleTextStyle}"
                                                    Text="至" />
                                                <NumberBox
                                                    Grid.Column="2"
                                                    Header="上限值"
                                                    Minimum="0"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{Binding Buffs.SelectedBuff.CompleteStacks, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="强度范围" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <NumberBox
                                                    Header="基础值"
                                                    Minimum="0"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{Binding Buffs.SelectedBuff.Strength, Mode=TwoWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="0,30,0,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SubtleTextStyle}"
                                                    Text="至" />
                                                <NumberBox
                                                    Grid.Column="2"
                                                    Header="上限值"
                                                    Minimum="0"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{Binding Buffs.SelectedBuff.CompleteStrength, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <ToggleSwitch
                                        HorizontalAlignment="Left"
                                        Header="层数归零是否结束"
                                        IsOn="{Binding Buffs.SelectedBuff.EndsWhenStacksReachZero, Mode=TwoWay}" />
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="效果模块" />
                                            <TextBlock
                                                Style="{StaticResource SubtleTextStyle}"
                                                Text="同一个 BUFF 可以组合多个通用效果或自定义蓝图行为。" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Click="AddBuffEffectButton_Click"
                                            ToolTipService.ToolTip="添加效果模块">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                                <TextBlock Text="添加效果" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Buffs.SelectedBuff.Effects, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,10,0,14" ColumnSpacing="10" RowSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <ComboBox
                                                        HorizontalAlignment="Stretch"
                                                        Header="效果类型"
                                                        SelectedValue="{Binding EffectType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedValuePath="Content">
                                                        <ComboBoxItem Content="属性修改" />
                                                        <ComboBoxItem Content="最终伤害" />
                                                        <ComboBoxItem Content="速度" />
                                                        <ComboBoxItem Content="技能锁定" />
                                                        <ComboBoxItem Content="防御" />
                                                        <ComboBoxItem Content="生命" />
                                                        <ComboBoxItem Content="自定义效果" />
                                                    </ComboBox>
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Stretch"
                                                        Header="作用目标"
                                                        SelectedValue="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedValuePath="Content">
                                                        <ComboBoxItem Content="自身" />
                                                        <ComboBoxItem Content="自身主战" />
                                                        <ComboBoxItem Content="自身护援" />
                                                        <ComboBoxItem Content="敌方主战" />
                                                        <ComboBoxItem Content="敌方护援" />
                                                        <ComboBoxItem Content="发送方" />
                                                        <ComboBoxItem Content="接收方" />
                                                    </ComboBox>
                                                    <TextBox
                                                        Grid.Column="2"
                                                        Header="属性 / 行为"
                                                        Text="{Binding Attribute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ComboBox
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Stretch"
                                                        Header="计算方式"
                                                        SelectedValue="{Binding Operation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedValuePath="Content">
                                                        <ComboBoxItem Content="加算" />
                                                        <ComboBoxItem Content="乘算" />
                                                        <ComboBoxItem Content="覆盖" />
                                                        <ComboBoxItem Content="锁定" />
                                                        <ComboBoxItem Content="蓝图逻辑" />
                                                    </ComboBox>
                                                    <Button
                                                        Grid.Column="4"
                                                        Margin="0,26,0,0"
                                                        CommandParameter="{Binding}"
                                                        Click="RemoveBuffEffectButton_Click"
                                                        ToolTipService.ToolTip="删除效果模块">
                                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                    </Button>
                                                    <NumberBox
                                                        Grid.Row="1"
                                                        Header="基础数值"
                                                        SmallChange="0.01"
                                                        SpinButtonPlacementMode="Inline"
                                                        Value="{Binding Value, Mode=TwoWay}" />
                                                    <NumberBox
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Header="每层增量"
                                                        SmallChange="0.01"
                                                        SpinButtonPlacementMode="Inline"
                                                        Value="{Binding PerStackValue, Mode=TwoWay}" />
                                                    <TextBox
                                                        Grid.Row="1"
                                                        Grid.Column="2"
                                                        Grid.ColumnSpan="2"
                                                        Header="蓝图实现说明"
                                                        Text="{Binding ImplementationNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Border
                                                        Grid.Row="2"
                                                        Grid.ColumnSpan="5"
                                                        Height="1"
                                                        Margin="0,4,0,0"
                                                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <StackPanel Spacing="10">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="生命周期实现" />
                                    <TextBox
                                        MinHeight="76"
                                        AcceptsReturn="True"
                                        Header="初始化"
                                        Text="{Binding Buffs.SelectedBuff.InitializationNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        MinHeight="76"
                                        AcceptsReturn="True"
                                        Header="条件更新"
                                        Text="{Binding Buffs.SelectedBuff.ConditionUpdateNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        MinHeight="76"
                                        AcceptsReturn="True"
                                        Header="完成"
                                        Text="{Binding Buffs.SelectedBuff.CompletionNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        MinHeight="76"
                                        AcceptsReturn="True"
                                        Header="移除"
                                        Text="{Binding Buffs.SelectedBuff.RemovalNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <StackPanel Spacing="10">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="说明与条件" />
                                    <TextBox
                                        MinHeight="112"
                                        AcceptsReturn="True"
                                        Header="BUFF 说明"
                                        Text="{Binding Buffs.SelectedBuff.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        MinHeight="112"
                                        AcceptsReturn="True"
                                        Header="制作草稿"
                                        Text="{Binding Buffs.SelectedBuff.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        MinHeight="84"
                                        AcceptsReturn="True"
                                        Header="条件摘要"
                                        Text="{Binding Buffs.SelectedBuff.ConditionSummary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <StackPanel Spacing="10">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="原始来源" />
                                    <TextBox
                                        Header="虚幻资产路径"
                                        KeyDown="BuffTextBox_KeyDown"
                                        Text="{Binding Buffs.SelectedBuff.SourceAssetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        MinHeight="84"
                                        AcceptsReturn="True"
                                        Header="读取状态"
                                        Text="{Binding Buffs.SelectedBuff.ReadStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Padding="26,16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding Buffs.StatusText, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                Click="BuffEditorCloseButton_Click"
                                Content="关闭"
                                Style="{StaticResource DialogAccentButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>


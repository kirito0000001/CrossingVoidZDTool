                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding Buffs.StatusText, Mode=OneWay}" />
                        </Grid>
                        <InfoBar
                            Grid.Row="1"
                            IsOpen="{Binding Buffs.IsNoticeOpen, Mode=OneWay}"
                            Message="{Binding Buffs.NoticeMessage, Mode=OneWay}"
                            Severity="{Binding Buffs.NoticeSeverity, Mode=OneWay}"
                            Title="{Binding Buffs.NoticeTitle, Mode=OneWay}" />
                        <ScrollViewer
                            x:Name="BuffsScrollViewer"
                            Grid.Row="2"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" IsHitTestVisible="{Binding CharacterDesk.CanEditCurrentCharacter, Mode=OneWay}">
                                <Border Style="{StaticResource PanelBorderStyle}">
                                    <Grid Padding="16" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="BUFF 卡" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="图标目标尺寸 125x125；BUFF 名称、归属、强度和层数会写入角色 JSON。" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Click="AddBuffButton_Click"
                                            Style="{StaticResource PrimaryToolButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon Symbol="Add" />
                                                <TextBlock Text="新增 BUFF" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Click="OpenBuffFolderButton_Click"
                                            Style="{StaticResource IconToolButtonStyle}"
                                            ToolTipService.ToolTip="打开 BUFF 文件夹">
                                            <FontIcon FontSize="18" Glyph="&#xE838;" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Buffs.Buffs, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid
                                                ItemWidth="178"
                                                Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Width="166"
                                                Height="190"
                                                Margin="0,0,12,12"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                CommandParameter="{Binding}"
                                                Click="OpenBuffEditorButton_Click">
                                                <Button.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem
                                                            Click="DeleteBuffMenuItem_Click"
                                                            CommandParameter="{Binding}"
                                                            Text="删除" />
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                                <Grid>
                                                    <Border Style="{StaticResource PanelBorderStyle}">
                                                        <Grid Padding="10" RowSpacing="8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="125" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Border
                                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                                <Grid>
                                                                    <Image Source="{Binding IconUri, Mode=OneWay}" Stretch="UniformToFill" />
                                                                    <TextBlock
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Style="{StaticResource SubtleTextStyle}"
                                                                        Text="图标"
                                                                        Visibility="{Binding HasNoIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="15"
                                                                FontWeight="SemiBold"
                                                                MaxLines="2"
                                                                Text="{Binding DisplayName, Mode=OneWay}"
                                                                TextAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <ScrollViewer
                    x:Name="UnrealProjectSyncPage"
                    Grid.Row="0"
                    Background="Transparent"
                    HorizontalScrollBarVisibility="Disabled"
                    RightTapped="PageBlankArea_RightTapped"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,12,0" RowSpacing="12" IsHitTestVisible="{Binding CharacterDesk.CanEditCurrentCharacter, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="虚幻同步台" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.DirectionDescription, Mode=OneWay}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                Header="同步方向"
                                IsOn="{Binding UnrealProjectSync.IsEngineToToolbox, Mode=TwoWay}"
                                OffContent="同步到虚幻"
                                OnContent="从虚幻导入"
                                Toggled="UnrealSyncDirectionToggle_Toggled" />
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                            <Grid Padding="12" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox IsReadOnly="True" PlaceholderText="UnrealEditor.exe" Text="{Binding UnrealProjectSync.EnginePath, Mode=OneWay}" />
                                <Button Grid.Column="1" Click="ChooseUnrealProjectSyncEngineButton_Click" Content="选择引擎" />
                                <TextBox Grid.Column="2" IsReadOnly="True" PlaceholderText="项目 .uproject" Text="{Binding UnrealProjectSync.ProjectPath, Mode=OneWay}" />
                                <Button Grid.Column="3" Click="ChooseUnrealProjectSyncProjectButton_Click" Content="选择项目" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Height="620" MinHeight="560" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="336" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                                <Grid Padding="12" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="同步来源" />
                                    <AutoSuggestBox
                                        x:Name="UnrealSyncSourceSearchBox"
                                        Grid.Row="1"
                                        PlaceholderText="搜索名称、代号或素材类别"
                                        Text="{Binding UnrealProjectSync.SourceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Expander Grid.Row="2" IsExpanded="False">
                                        <Expander.Header>
                                            <TextBlock FontWeight="SemiBold" Text="项目通用素材（待支持）" />
                                        </Expander.Header>
                                        <ListView
                                            MaxHeight="150"
                                            IsItemClickEnabled="True"
                                            ItemClick="UnrealSyncSourceListView_ItemClick"
                                            ItemsSource="{Binding UnrealProjectSync.FilteredSharedMaterialSources, Mode=OneWay}"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Padding="8,5" Spacing="1">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                        <TextBlock FontSize="12" Style="{StaticResource SubtleTextStyle}" Text="{Binding AvailabilityText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Expander>
                                    <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="{Binding UnrealProjectSync.SourceGroupTitle, Mode=OneWay}" />
                                    <ListView
                                        x:Name="UnrealSyncCharacterSourceListView"
                                        Grid.Row="4"
                                        ItemsSource="{Binding UnrealProjectSync.CharacterSources, Mode=OneWay}"
                                        IsItemClickEnabled="True"
                                        ItemClick="UnrealSyncSourceListView_ItemClick"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedItem="{Binding UnrealProjectSync.SelectedSource, Mode=OneWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="MinHeight" Value="52" />
                                                <Setter Property="Margin" Value="0,0,0,2" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="52" Padding="10,5" HorizontalAlignment="Stretch">
                                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{Binding DisplayName}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{Binding DisplayName}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Style="{StaticResource SubtleTextStyle}"
                                                            Text="{Binding SecondaryText}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{Binding SecondaryText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Button
                                        x:Name="RefreshUnrealCharactersButton"
                                        Grid.Row="5"
                                        HorizontalAlignment="Stretch"
                                        Click="GetUnrealProjectCharactersButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Refresh" />
                                            <TextBlock Text="刷新来源列表" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                                <Grid Padding="14" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="3">
                                         <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding UnrealProjectSync.WorkspaceTitle, Mode=OneWay}" />
                                         <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.WorkspaceDescription, Mode=OneWay}" />
                                             </StackPanel>
                                    <StackPanel
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="620"
                                        Spacing="10"
                                        Visibility="{Binding UnrealProjectSync.WorkspacePlaceholderVisibility, Mode=OneWay}">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            FontSize="30"
                                            Glyph="{Binding UnrealProjectSync.WorkspacePlaceholderGlyph, Mode=OneWay}" />
                                        <ProgressBar
                                            Width="220"
                                            IsIndeterminate="True"
                                            Visibility="{Binding UnrealProjectSync.WorkspaceBusyVisibility, Mode=OneWay}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="{Binding UnrealProjectSync.WorkspacePlaceholderTitle, Mode=OneWay}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource SubtleTextStyle}"
                                            Text="{Binding UnrealProjectSync.WorkspacePlaceholderDescription, Mode=OneWay}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ScrollViewer
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto"
                                        Visibility="{Binding UnrealProjectSync.LightConfigurationWorkspaceVisibility, Mode=OneWay}">
                                         <StackPanel Spacing="10">
                                             <ItemsControl ItemsSource="{Binding UnrealProjectSync.LightConfigurationItems, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="0,0,0,12"
                                                            Padding="10"
                                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <StackPanel Spacing="8">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox
                                                                        VerticalAlignment="Center"
                                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                        IsEnabled="{Binding IsSelectable}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Center"
                                                                        FontSize="18"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding DisplayName}" />
                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        MinWidth="56"
                                                                        Style="{StaticResource SubtleTextStyle}"
                                                                        Text="{Binding StatusText}"
                                                                        TextAlignment="Right" />
                                                                </Grid>
                                                                <Border
                                                                    Margin="0,0,18,4"
                                                                    Padding="8,6"
                                                                    HorizontalAlignment="Stretch"
                                                                    Style="{StaticResource LogErrorBlockStyle}"
                                                                    Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                                    <StackPanel>
                                                                        <TextBlock
                                                                            Style="{StaticResource LogErrorTextStyle}"
                                                                            Text="{Binding CurrentValueText}"
                                                                            TextWrapping="Wrap"
                                                                            Visibility="{Binding IsTagList, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                                                        <ItemsControl
                                                                            Style="{StaticResource UnrealLightConfigurationValuesControlStyle}"
                                                                            ItemsSource="{Binding CurrentValueItems, Mode=OneWay}"
                                                                            ItemTemplate="{StaticResource UnrealLightConfigurationErrorValueTemplate}"
                                                                            ItemsPanel="{StaticResource UnrealLightConfigurationValuesPanelTemplate}"
                                                                            Visibility="{Binding IsTagList, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border
                                                                    Margin="0,0,18,0"
                                                                    Padding="8,6"
                                                                    HorizontalAlignment="Stretch"
                                                                    Style="{StaticResource LogDefaultBlockStyle}"
                                                                    Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                                    <StackPanel>
                                                                        <TextBlock
                                                                            Style="{StaticResource LogDefaultTextStyle}"
                                                                            Text="{Binding TargetValueText}"
                                                                            TextWrapping="Wrap"
                                                                            Visibility="{Binding IsTagList, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                                                        <ItemsControl
                                                                            Style="{StaticResource UnrealLightConfigurationValuesControlStyle}"
                                                                            ItemsSource="{Binding TargetValueItems, Mode=OneWay}"
                                                                            ItemTemplate="{StaticResource UnrealLightConfigurationDefaultValueTemplate}"
                                                                            ItemsPanel="{StaticResource UnrealLightConfigurationValuesPanelTemplate}"
                                                                            Visibility="{Binding IsTagList, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border
                                                                    Margin="0,0,18,0"
                                                                    Padding="8,6"
                                                                    Style="{StaticResource LogErrorBlockStyle}"
                                                                    Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                                    <TextBlock
                                                                        Style="{StaticResource LogErrorTextStyle}"
                                                                        Text="{Binding ErrorText}"
                                                                        TextWrapping="Wrap" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer
                                        Grid.Row="1"
                                        Padding="0,0,6,0"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto"
                                        Visibility="{Binding UnrealProjectSync.BlueprintSetupWorkspaceVisibility, Mode=OneWay}">
                                        <ItemsControl ItemsSource="{Binding UnrealProjectSync.BlueprintSetupGroups, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,14" Spacing="8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                FontSize="15"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding GroupName}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource SubtleTextStyle}"
                                                                Text="{Binding SummaryText}" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Margin="0,0,0,10"
                                                                        Padding="10"
                                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6">
                                                                        <StackPanel Spacing="8">
                                                                            <Grid ColumnSpacing="8">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <CheckBox
                                                                                    VerticalAlignment="Center"
                                                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                    IsEnabled="{Binding IsSelectable}" />
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                    <TextBlock
                                                                                        FontSize="15"
                                                                                        FontWeight="SemiBold"
                                                                                        Text="{Binding DisplayName}"
                                                                                        TextWrapping="Wrap" />
                                                                                    <TextBlock
                                                                                        Style="{StaticResource SubtleTextStyle}"
                                                                                        Text="{Binding TargetField}"
                                                                                        TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                                <TextBlock
                                                                                    Grid.Column="2"
                                                                                    VerticalAlignment="Center"
                                                                                    MinWidth="56"
                                                                                    Style="{StaticResource SubtleTextStyle}"
                                                                                    Text="{Binding StatusText}"
                                                                                    TextAlignment="Right" />
                                                                            </Grid>
                                                                            <Border
                                                                                Padding="8,6"
                                                                                HorizontalAlignment="Stretch"
                                                                                Style="{StaticResource LogErrorBlockStyle}"
                                                                                Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                                                <StackPanel>
                                                                                    <TextBlock
                                                                                        Style="{StaticResource LogErrorTextStyle}"
                                                                                        Text="{Binding CurrentValueText}"
                                                                                        TextWrapping="Wrap"
                                                                                        Visibility="{Binding IsTagList, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                                                                    <ItemsControl
                                                                                        Style="{StaticResource UnrealLightConfigurationValuesControlStyle}"
                                                                                        ItemsSource="{Binding CurrentValueItems, Mode=OneWay}"
                                                                                        ItemTemplate="{StaticResource UnrealLightConfigurationErrorValueTemplate}"
                                                                                        ItemsPanel="{StaticResource UnrealLightConfigurationValuesPanelTemplate}"
                                                                                        Visibility="{Binding IsTagList, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <Border
                                                                                Padding="8,6"
                                                                                HorizontalAlignment="Stretch"
                                                                                Style="{StaticResource LogDefaultBlockStyle}"
                                                                                Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                                                <StackPanel>
                                                                                    <TextBlock
                                                                                        Style="{StaticResource LogDefaultTextStyle}"
                                                                                        Text="{Binding TargetValueText}"
                                                                                        TextWrapping="Wrap"
                                                                                        Visibility="{Binding IsTagList, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                                                                                    <ItemsControl
                                                                                        Style="{StaticResource UnrealLightConfigurationValuesControlStyle}"
                                                                                        ItemsSource="{Binding TargetValueItems, Mode=OneWay}"
                                                                                        ItemTemplate="{StaticResource UnrealLightConfigurationDefaultValueTemplate}"
                                                                                        ItemsPanel="{StaticResource UnrealLightConfigurationValuesPanelTemplate}"
                                                                                        Visibility="{Binding IsTagList, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <Border
                                                                                Padding="8,6"
                                                                                Style="{StaticResource LogErrorBlockStyle}"
                                                                                Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                                                <TextBlock
                                                                                    Style="{StaticResource LogErrorTextStyle}"
                                                                                    Text="{Binding ErrorText}"
                                                                                    TextWrapping="Wrap" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <ScrollViewer
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto"
                                        Visibility="{Binding UnrealProjectSync.FoundationWorkspaceVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="3">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="底层检测" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="检查同步所需的 Unreal 目录和角色 Item 是否符合规范。" TextWrapping="Wrap" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding UnrealProjectSync.FoundationSummaryText, Mode=OneWay}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding UnrealProjectSync.VisibleFoundationChecks, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="0,0,0,6"
                                                            Padding="12"
                                                            Style="{StaticResource PanelBorderStyle}"
                                                            Tag="{Binding}"
                                                            Tapped="UnrealFoundationCheckItem_Tapped"
                                                            ToolTipService.ToolTip="点击复制正确名称">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding ExpectedSummaryText}" TextWrapping="Wrap" />
                                                                    <TextBlock FontSize="12" Style="{StaticResource SubtleTextStyle}" Text="{Binding DetailText}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StatusText}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                        <ScrollViewer
                                            Grid.Row="1"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto"
                                            Visibility="{Binding UnrealProjectSync.SelectionContentVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="10">
                                            <ItemsControl ItemsSource="{Binding UnrealProjectSync.SelectionTreeRoots, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander Margin="0,0,0,6" IsExpanded="True">
                                                        <Expander.Header>
                                                            <Grid Height="42" VerticalAlignment="Center" HorizontalAlignment="Stretch" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Width="32" Height="32" VerticalAlignment="Center">
                                                                    <CheckBox
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch"
                                                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                        IsEnabled="{Binding IsSelectable}"
                                                                        IsThreeState="True"
                                                                        Opacity="0"
                                                                        ToolTipService.ToolTip="全选或取消本组"
                                                                        Click="UnrealSyncSelectionCheckBox_Click" />
                                                                    <Border
                                                                        x:Name="UnrealSyncUncheckedIndicator"
                                                                        Width="20"
                                                                        Height="20"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Background="Transparent"
                                                                        BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="3"
                                                                        IsHitTestVisible="False"
                                                                        Visibility="{Binding IsGroupUnchecked, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                                    <Border
                                                                        x:Name="UnrealSyncCheckedIndicator"
                                                                        Width="20"
                                                                        Height="20"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                        CornerRadius="3"
                                                                        IsHitTestVisible="False"
                                                                        Visibility="{Binding IsGroupChecked, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                                        <FontIcon
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="12"
                                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                            Glyph="&#xE73E;" />
                                                                    </Border>
                                                                    <Border
                                                                        x:Name="UnrealSyncIndeterminateIndicator"
                                                                        Width="20"
                                                                        Height="20"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                        CornerRadius="3"
                                                                        IsHitTestVisible="False"
                                                                        Visibility="{Binding IsIndeterminate, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">

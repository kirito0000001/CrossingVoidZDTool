                                                            AcceptsReturn="True"
                                                            MinHeight="48"
                                                                                              
                                                            PlaceholderText="填写技能描述"
                                                                                                      
                                                            Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                            
                                                            TextWrapping="Wrap" />

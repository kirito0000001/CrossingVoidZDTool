            MaxWidth="520"
            Margin="0,18,28,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Canvas.ZIndex="330"
            Spacing="6" />

        <Grid
            x:Name="BuffEditorHost"
            Grid.RowSpan="2"
            Background="#8C000000"
            Canvas.ZIndex="145"

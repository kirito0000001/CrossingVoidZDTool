                                                    <ItemsControl ItemsSource="{Binding UnrealProjectSync.CheckItems, Mode=OneWay}" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

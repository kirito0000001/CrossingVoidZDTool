<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CrossingVoidZDTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:CrossingVoidZDTool.Controls"
    xmlns:local="using:CrossingVoidZDTool"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="零境交错：ZD工具箱"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="UnrealLightConfigurationValuesControlStyle" TargetType="ItemsControl">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <ItemsPanelTemplate x:Key="UnrealLightConfigurationValuesPanelTemplate">
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
            <DataTemplate x:Key="UnrealLightConfigurationErrorValueTemplate">
                <Border
                    Margin="0,0,0,4"
                    Padding="6,3"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource LogErrorBlockStyle}">
                    <TextBlock
                        Style="{StaticResource LogErrorTextStyle}"
                        Text="{Binding}"
                        TextWrapping="Wrap" />
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="UnrealLightConfigurationDefaultValueTemplate">
                <Border
                    Margin="0,0,0,4"
                    Padding="6,3"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource LogDefaultBlockStyle}">
                    <TextBlock
                        Style="{StaticResource LogDefaultTextStyle}"
                        Text="{Binding}"
                        TextWrapping="Wrap" />
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="VoiceMaterialPrimaryItemTemplate">
                <Grid MinHeight="40" Margin="0,2,0,2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Click="PlayVoiceMaterialButton_Click"
                        IsEnabled="{Binding CanPlay, Mode=OneWay}"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTipService.ToolTip="播放或停止试听">
                        <SymbolIcon Symbol="Play" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="3"
                        Click="ReplaceVoiceMaterialButton_Click"
                        IsEnabled="{Binding CanPlay, Mode=OneWay}"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTipService.ToolTip="替换这条语音">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        Click="DeleteVoiceMaterialButton_Click"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTipService.ToolTip="删除这条语音">
                        <SymbolIcon Symbol="Delete" />
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="VoiceMaterialManagerItemTemplate">
                <Grid MinHeight="40" Margin="0,2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Click="PlayVoiceMaterialButton_Click"
                        IsEnabled="{Binding CanPlay, Mode=OneWay}"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTipService.ToolTip="播放或停止试听">
                        <SymbolIcon Symbol="Play" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Style="{StaticResource SubtleTextStyle}"
                            Text="{Binding UsageText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding UsageText, Mode=OneWay}"
                            Visibility="{Binding HasUsageText, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Text="{Binding DuplicateStatusText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding DuplicateStatusText, Mode=OneWay}"
                            Visibility="{Binding HasDuplicateStatus, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Click="ReplaceVoiceMaterialButton_Click"
                        IsEnabled="{Binding CanPlay, Mode=OneWay}"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTipService.ToolTip="替换这条语音">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Click="DeleteVoiceMaterialButton_Click"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTipService.ToolTip="删除这条语音">
                        <SymbolIcon Symbol="Delete" />
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="VoiceMaterialSectionTemplate">
                <Border
                    Width="560"
                    MinHeight="132"
                    Margin="0,0,12,12"
                    Padding="14"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Spec.DisplayName, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}">
                                    <Run Text="{Binding Spec.RequirementText, Mode=OneWay}" />
                                    <Run Text="，" />
                                    <Run Text="{Binding StatusText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Click="AddVoiceMaterialButton_Click"
                                Style="{StaticResource IconToolButtonStyle}"
                                Tag="{Binding Spec, Mode=OneWay}"
                                ToolTipService.ToolTip="导入 WAV 语音">
                                <SymbolIcon Symbol="Add" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                x:Name="VoiceMaterialManagerButton"
                                Click="OpenVoiceMaterialManagerButton_Click"
                                IsEnabled="{Binding HasItems, Mode=OneWay}"
                                Style="{StaticResource IconToolButtonStyle}"
                                Tag="{Binding}"
                                ToolTipService.ToolTip="管理已设置语音"
                                Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <SymbolIcon Symbol="More" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                Click="OpenVoiceMaterialFolderButton_Click"
                                Style="{StaticResource IconToolButtonStyle}"
                                Tag="{Binding Spec.Kind, Mode=OneWay}"
                                ToolTipService.ToolTip="打开语音分类文件夹">
                                <SymbolIcon Symbol="OpenFile" />
                            </Button>
                        </Grid>
                        <ContentControl
                            Grid.Row="1"
                            Content="{Binding PrimaryItem, Mode=OneWay}"
                            ContentTemplate="{StaticResource VoiceMaterialPrimaryItemTemplate}"
                            HorizontalContentAlignment="Stretch"
                            Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock
                            x:Name="VoiceMaterialEmptyStateText"
                            Grid.Row="1"
                            Style="{StaticResource SubtleTextStyle}"
                            Text="未设置"
                            Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="SequenceFrameSectionTemplate">
                <Border
                    Width="340"
                    MinHeight="188"
                    Margin="0,0,10,10"
                    Padding="12"
                    AllowDrop="True"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    DragOver="SequenceFrameSection_DragOver"
                    Drop="SequenceFrameSection_Drop"
                    Tag="{Binding}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Action.DisplayName, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding Action.Code, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                CommandParameter="{Binding}"
                                Click="ImportSequenceFramesButton_Click"
                                Style="{StaticResource IconToolButtonStyle}"
                                ToolTipService.ToolTip="导入这一组序列帧">
                                <SymbolIcon Symbol="Add" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                CommandParameter="{Binding}"
                                Click="OpenSequenceFrameFolderButton_Click"
                                Style="{StaticResource IconToolButtonStyle}"
                                ToolTipService.ToolTip="打开动作文件夹">
                                <FontIcon FontSize="18" Glyph="&#xE838;" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                CommandParameter="{Binding}"
                                Click="PreviewSequenceFramesButton_Click"
                                Style="{StaticResource IconToolButtonStyle}"
                                ToolTipService.ToolTip="放入右侧预览器">
                                <SymbolIcon Symbol="Play" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding StatusText, Mode=OneWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding PreviewFrames, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Width="78"
                                                Height="62"
                                                Margin="0,0,4,0"
                                                Padding="0"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Click="PreviewThumbnailSequenceButton_Click"
                                                ToolTipService.ToolTip="查看全部序列帧并排序">
                                                <Image Source="{Binding FileUri, Mode=OneWay}" Stretch="Uniform" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    Grid.Column="1"
                                    Width="46"
                                    Height="62"
                                    Padding="0"
                                    CommandParameter="{Binding}"
                                    Click="ManageSequenceFramesButton_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="查看全部序列帧并排序">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="..." />
                                </Button>
                                                 </Grid>
                                             </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="SequenceFrameSectionGroupTemplate">
                <Border Margin="0,0,0,12" Style="{StaticResource PanelBorderStyle}">
                    <Grid Padding="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Title, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding Description, Mode=OneWay}" />
                        </StackPanel>
                        <ItemsControl
                            Grid.Row="1"
                            ItemTemplate="{StaticResource SequenceFrameSectionTemplate}"
                            ItemsSource="{Binding Sections, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        ItemWidth="350"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>
            </DataTemplate>

        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="18,0,170,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" VerticalAlignment="Center" CornerRadius="7">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="零境交错：ZD工具箱"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="1.0.0" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            CompactPaneLength="64"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            Loaded="ShellNavigation_Loaded"
            OpenPaneLength="286"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ShellNavigation_SelectionChanged"
            SelectionFollowsFocus="Disabled">
            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">64</x:Double>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="CharacterDeskNavItem"
                    Content="零境角色台"
                    IsSelected="True"
                    Tag="CharacterDesk">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="St1DesignNavItem" Content="St1-设计理念" Tag="ActionFrames">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Edit" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="St2MaterialNavItem" Content="St2-基础素材" Tag="LineArt">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="St3CharacterInfoNavItem" Content="St3-角色信息" Tag="UnrealSync">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="St4SkillsNavItem" Content="St4-技能" Tag="Skills">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Bullets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="St5SequenceFramesNavItem" Content="St5-序列帧" Tag="SequenceFrames">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Video" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="St6BuffsNavItem" Content="St6-BUFF" Tag="Buffs">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Important" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="UnrealProjectSyncNavItem" Content="虚幻同步台" Tag="UnrealProjectSync">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sync" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="GlobalSettingsNavItem" Content="整体设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="CharacterDeskPage"
                    Background="Transparent"
                    RightTapped="PageBlankArea_RightTapped"
                    RowSpacing="14"
                    Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="零境角色台" />
                            <TextBlock
                                Style="{StaticResource SubtleTextStyle}"
                                Text="已创建角色卡总览。角色建立后，后续步骤都会围绕当前制作角色继续。" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="{Binding CharacterDesk.LastEditedCharacterText, Mode=OneWay}"
                            IsEnabled="{Binding CharacterDesk.HasLastEditedCharacter, Mode=OneWay}"
                            Click="ContinueLastCharacterButton_Click"
                            Style="{StaticResource PrimaryToolButtonStyle}"
                            ToolTipService.ToolTip="快捷选择上次编辑的角色" />
                        <Button
                            Grid.Column="2"
                            Click="RefreshCharactersButton_Click"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="刷新角色台">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                        <Grid Padding="18" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="角色卡" />
                                <ProgressRing
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    IsActive="{Binding CharacterDesk.IsLoadingCharacters, Mode=OneWay}"
                                    Visibility="{Binding CharacterDesk.IsLoadingCharacters, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                            </Grid>

                            <ScrollViewer
                                x:Name="CharacterCardsScrollViewer"
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Enabled">
                            <ItemsControl ItemsSource="{Binding CharacterDesk.CompletedCharacters, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate                                 >
                                        <Button
                                            Margin="0,0,12,12"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CommandParameter="{Binding}"
                                            Click="CharacterCardButton_Click"
                                            RightTapped="CharacterCardButton_RightTapped">
                                            <Border
                                                Width="150"
                                                Padding="8"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid Width="134" HorizontalAlignment="Center" RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="288" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border
                                                        Width="134"
                                                        Height="288"
                                                        HorizontalAlignment="Center"
                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                        CornerRadius="4">
                                                        <Image
                                                            Width="134"
                                                            Height="288"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Source="{Binding EffectiveCoverUri, Mode=OneWay}"
                                                            RenderTransformOrigin="0.5,0.5"
                                                            Stretch="UniformToFill">
                                                            <Image.RenderTransform>
                                                                <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                                            </Image.RenderTransform>
                                                        </Image>
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding EffectiveDisplayName, Mode=OneWay}"
                                                        TextAlignment="Center"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border x:Name="WorkspaceStatusBorder" Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <Grid Padding="14,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="WorkspaceStatusText"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding CharacterDesk.StatusText, Mode=OneWay}" />
                            <ProgressBar
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsIndeterminate="False"
                                Value="0" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    x:Name="ActionFramesPage"
                    Grid.Row="0"
                    Background="Transparent"
                    RightTapped="PageBlankArea_RightTapped"
                    Visibility="Collapsed">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            ColumnSpacing="16"
                            Visibility="{Binding CharacterDesk.IsDraftOpen, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="St1-设计理念" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding CharacterDesk.CurrentCharacterStatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Style="{StaticResource PanelBorderStyle}"
                            Visibility="{Binding CharacterDesk.IsDraftOpen, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                            <StackPanel Padding="22" Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                <ItemsControl
                                    ItemsSource="{Binding CharacterDesk.DraftCharacters, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate                                          >
                                            <Border
                                                Margin="0"
                                                DataContext="{Binding}"
                                                Tapped="PortraitEntryCard_Tapped"
                                                RightTapped="PortraitEntryButton_RightTapped">
                                                <Border
                                                    Width="150"
                                                    Padding="8"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <Grid Width="134" HorizontalAlignment="Center" RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="288" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border
                                                            Width="134"
                                                            Height="288"
                                                            HorizontalAlignment="Center"
                                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                                            CornerRadius="4">
                                                            <Image
                                                                Width="134"
                                                                Height="288"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Source="{Binding EffectiveCoverUri, Mode=OneWay}"
                                                                RenderTransformOrigin="0.5,0.5"
                                                                Stretch="UniformToFill">
                                                                <Image.RenderTransform>
                                                                    <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                                                </Image.RenderTransform>
                                                            </Image>
                                                        </Border>
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            FontSize="16"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding EffectiveDisplayName, Mode=OneWay}"
                                                            TextAlignment="Center"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                    <Button
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="AddCharacterButton_Click"
                                        ToolTipService.ToolTip="在 St1 创建新的角色卡">
                                        <Border
                                            Width="150"
                                            Padding="8"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <Grid Width="134" HorizontalAlignment="Center" RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="288" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border
                                                    Width="134"
                                                    Height="288"
                                                    HorizontalAlignment="Center"
                                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                                    CornerRadius="4">
                                                    <SymbolIcon
                                                        Width="48"
                                                        Height="48"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Symbol="Add" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="新建角色卡"
                                                    TextAlignment="Center"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SubtleTextStyle}"
                                    Text="这个角色已完成制作。后续请从角色台选择角色后进入对应步骤继续编辑。"
                                    Visibility="{Binding CharacterDesk.IsCurrentCharacterCompleted, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Style="{StaticResource PanelBorderStyle}"
                            Visibility="{Binding CharacterDesk.IsDraftOpen, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <Grid Padding="14" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding CharacterDesk.CurrentCharacterName, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding CharacterDesk.DraftSaveStatusText, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <TextBox
                                    Grid.Row="1"
                                    AcceptsReturn="True"
                                    FontFamily="Microsoft YaHei UI"
                                    FontSize="18"
                                    Header="草稿本"
                                    IsEnabled="{Binding CharacterDesk.HasCurrentCharacter, Mode=OneWay}"
                                    IsReadOnly="{Binding CharacterDesk.IsViewOnly, Mode=OneWay}"
                                    PlaceholderText="在这里记录设计理念、灵感、动作想法和临时草稿。"
                                    Text="{Binding CharacterDesk.DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" />

                                <Expander
                                    Grid.Row="2"
                                    IsExpanded="{Binding CharacterDesk.IsReferencePanelExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid MinHeight="48" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SectionTitleStyle}"
                                                Text="参考图" />
                                            <Button
                                                Grid.Column="1"
                                                Click="ImportReferenceImagesButton_Click"
                                                IsEnabled="{Binding CharacterDesk.CanEditCurrentCharacter, Mode=OneWay}"
                                                Style="{StaticResource IconToolButtonStyle}"
                                                >
                                                <SymbolIcon Symbol="Import" />
                                            </Button>
                                            <Button
                                                Grid.Column="2"
                                                Click="OpenReferenceFolderButton_Click"
                                                IsEnabled="{Binding CharacterDesk.HasCurrentCharacter, Mode=OneWay}"
                                                Style="{StaticResource IconToolButtonStyle}"
                                                >
                                                <SymbolIcon Symbol="OpenFile" />
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                        <Border
                                            MinHeight="260"
                                            Padding="12"
                                            AllowDrop="{Binding CharacterDesk.CanEditCurrentCharacter, Mode=OneWay}"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        DragOver="ReferenceImages_DragOver"
                                        Drop="ReferenceImages_Drop">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Style="{StaticResource SubtleTextStyle}"
                                                Text="可拖入 png、jpg、jpeg、webp、bmp 图片，或使用右侧导入按钮。" />
                                            <GridView
                                                Grid.Row="1"
                                                MinHeight="210"
                                                ItemsSource="{Binding CharacterDesk.ReferenceImages, Mode=OneWay}"
                                                SelectionMode="None">
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="local:CharacterReferenceImage">
                                                        <GridViewItem
                                                            Width="180"
                                                            Height="206"
                                                            Margin="0,0,10,10"
                                                            Padding="0"
                                                            DoubleTapped="ReferenceImageCard_DoubleTapped"
                                                            RightTapped="ReferenceImageCard_RightTapped"
                                                            Tapped="ReferenceImageCard_Tapped">
                                                            <Border
                                                                Width="180"
                                                                Height="206"
                                                                Padding="8"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                                <Grid RowSpacing="8">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="148" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="4">
                                                                        <Image Loaded="ReferenceThumbnailImage_Loaded" Stretch="Uniform" />
                                                                    </Border>
                                                                    <TextBlock
                                                                        Grid.Row="1"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding FileName, Mode=OneWay}"
                                                                        TextAlignment="Center"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Border>
                                                        </GridViewItem>
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </Grid>
                                    </Border>
                                </Expander>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>

                <Grid
                    x:Name="LineArtPage"
                    Grid.Row="0"
                    Background="Transparent"
                    RightTapped="PageBlankArea_RightTapped"
                    Visibility="Collapsed">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="St2-基础素材" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding CharacterDesk.CurrentCharacterStatusText, Mode=OneWay}" />
                            <InfoBar
                                IsClosable="False"
                                IsOpen="{Binding CharacterDesk.IsViewOnly, Mode=OneWay}"
                                Message="当前页面仅供查看，不能修改角色内容。"
                                Severity="Informational"
                                Title="查看角色中" />
                        </StackPanel>
                        <InfoBar
                            Grid.Row="1"
                            IsOpen="{Binding LineArt.IsNoticeOpen, Mode=OneWay}"
                            Message="{Binding LineArt.NoticeMessage, Mode=OneWay}"
                            Severity="{Binding LineArt.NoticeSeverity, Mode=OneWay}"
                            Title="{Binding LineArt.NoticeTitle, Mode=OneWay}" />
                        <ScrollViewer
                            x:Name="LineArtScrollViewer"
                            Grid.Row="2"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16" IsHitTestVisible="{Binding CharacterDesk.CanEditCurrentCharacter, Mode=OneWay}">
                            <ItemsControl ItemsSource="{Binding LineArt.Sections, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate                                       >
                                        <Border Margin="0,0,0,12" Style="{StaticResource PanelBorderStyle}">
                                            <Grid Padding="16" RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Spec.DisplayName, Mode=OneWay}" />
                                                        <TextBlock Style="{StaticResource SubtleTextStyle}">
                                                            <Run Text="{Binding Spec.TargetText, Mode=OneWay}" />
                                                            <Run Text="，" />
                                                            <Run Text="{Binding Spec.CountRequirementText, Mode=OneWay}" />
                                                            <Run Text="，" />
                                                            <Run Text="{Binding StatusText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        Click="AddBaseMaterialButton_Click"
                                                        Style="{StaticResource IconToolButtonStyle}"
                                                        Tag="{Binding Spec.Kind, Mode=OneWay}"
                                                        ToolTipService.ToolTip="上传并裁剪素材">
                                                        <SymbolIcon Symbol="Add" />
                                                    </Button>
                                                    <Button
                                                        Grid.Column="2"
                                                        Click="OpenBaseMaterialFolderButton_Click"
                                                        Style="{StaticResource IconToolButtonStyle}"
                                                        Tag="{Binding Spec.Kind, Mode=OneWay}"
                                                        ToolTipService.ToolTip="打开素材文件夹">
                                                        <SymbolIcon Symbol="OpenFile" />
                                                    </Button>
                                                </Grid>

                                                <ItemsControl
                                                    Grid.Row="1"
                                                    ItemsSource="{Binding Items, Mode=OneWay}"
                                                    Visibility="{Binding UsesStandardLayout, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <ItemsWrapGrid Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate                                    >
                                                            <Border
                                                                Width="210"
                                                                Margin="0,0,10,10"
                                                                Padding="10"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                                <Border.ContextFlyout>
                                                                    <MenuFlyout>
                                                                        <MenuFlyoutItem
                                                                            Text="修复"
                                                                            Click="RepairBaseMaterialMenuItem_Click"
                                                                            Tag="{Binding}" />
                                                                        <MenuFlyoutItem
                                                                            Text="重新导入"
                                                                            Click="ReimportBaseMaterialMenuItem_Click"
                                                                            Tag="{Binding}" />
                                                                    </MenuFlyout>
                                                                </Border.ContextFlyout>
                                                                <StackPanel Spacing="8">
                                                                    <Grid Height="112" Background="{ThemeResource LayerFillColorAltBrush}">
                                                                        <Image Source="{Binding FileUri, Mode=OneWay}" Stretch="Uniform" />
                                                                    </Grid>
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding StatusText, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl
                                                    Grid.Row="1"
                                                    ItemsSource="{Binding SlotGroups, Mode=OneWay}"
                                                    Visibility="{Binding HasFixedSlots, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <ItemsWrapGrid Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel
                                                                MinWidth="440"
                                                                Margin="0,0,16,8"
                                                                Spacing="8">
                                                                <TextBlock
                                                                    FontSize="15"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding PlayerLabel, Mode=OneWay}" />
                                                                <ItemsControl ItemsSource="{Binding Slots, Mode=OneWay}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="10" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border
                                                                                Width="210"
                                                                                Padding="10"
                                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6">
                                                                                <Border.ContextFlyout>
                                                                                    <MenuFlyout>
                                                                                        <MenuFlyoutItem
                                                                                            Click="RepairBaseMaterialMenuItem_Click"
                                                                                            IsEnabled="{Binding HasItem, Mode=OneWay}"
                                                                                            Tag="{Binding Item, Mode=OneWay}"
                                                                                            Text="修复" />
                                                                                        <MenuFlyoutItem
                                                                                            Click="ReimportBaseMaterialMenuItem_Click"
                                                                                            IsEnabled="{Binding HasItem, Mode=OneWay}"
                                                                                            Tag="{Binding Item, Mode=OneWay}"
                                                                                            Text="重新导入" />
                                                                                    </MenuFlyout>
                                                                                </Border.ContextFlyout>
                                                                                <StackPanel Spacing="8">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock
                                                                                            VerticalAlignment="Center"
                                                                                            FontWeight="SemiBold"
                                                                                            Text="{Binding DisplayName, Mode=OneWay}" />
                                                                                        <Button
                                                                                            Grid.Column="1"
                                                                                            Click="ImportBattleAvatarSlotButton_Click"
                                                                                            Style="{StaticResource IconToolButtonStyle}"
                                                                                            Tag="{Binding}"
                                                                                            ToolTipService.ToolTip="导入或替换此槽位">
                                                                                            <SymbolIcon Symbol="Add" />
                                                                                        </Button>
                                                                                    </Grid>
                                                                                    <Grid Height="112" Background="{ThemeResource LayerFillColorAltBrush}">
                                                                                        <Image Source="{Binding Item.FileUri, Mode=OneWay}" Stretch="Uniform" />
                                                                                        <TextBlock
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center"
                                                                                            Style="{StaticResource SubtleTextStyle}"
                                                                                            Text="尚未导入"
                                                                                            Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                                                                                    </Grid>
                                                                                    <TextBlock
                                                                                        FontWeight="SemiBold"
                                                                                        Text="{Binding FileName, Mode=OneWay}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding StatusText, Mode=OneWay}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                <StackPanel Margin="0,4,0,0" Spacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource PageTitleStyle}" FontSize="24" Text="语音素材" />
                                        <TextBlock Style="{StaticResource SubtleTextStyle}" Text="仅支持具有有效 RIFF/WAVE 文件头的 WAV 文件；可在工具内直接试听。" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="固定语音" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource VoiceMaterialSectionTemplate}"
                                        ItemsSource="{Binding LineArt.RequiredVoiceSections, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid ItemWidth="572" Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="扩展语音" />
                                    <ItemsControl
                                        ItemTemplate="{StaticResource VoiceMaterialSectionTemplate}"
                                        ItemsSource="{Binding LineArt.OptionalVoiceSections, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid ItemWidth="572" Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="UnrealSyncPage"
                    Grid.Row="0"
                    Background="Transparent"
                    RightTapped="PageBlankArea_RightTapped"
                    Tapped="UnrealSyncBlankArea_Tapped"

                    Visibility="Collapsed">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button
                            x:Name="UnrealSyncFocusSink"
                            Width="1"
                            Height="1"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsTabStop="True"
                            Opacity="0" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="St3-角色信息" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding CharacterDesk.CurrentCharacterStatusText, Mode=OneWay}" />
                                <InfoBar
                                    IsClosable="False"
                                    IsOpen="{Binding CharacterDesk.IsViewOnly, Mode=OneWay}"
                                    Message="当前页面仅供查看，不能修改角色内容。"
                                    Severity="Informational"
                                    Title="查看角色中" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding UnrealSync.SaveStatusText, Mode=OneWay}" />
                        </Grid>
                        <InfoBar
                            Grid.Row="1"
                            IsOpen="{Binding UnrealSync.IsNoticeOpen, Mode=OneWay}"
                            Message="{Binding UnrealSync.NoticeMessage, Mode=OneWay}"
                            Severity="{Binding UnrealSync.NoticeSeverity, Mode=OneWay}"
                            Title="{Binding UnrealSync.NoticeTitle, Mode=OneWay}" />
                        <ScrollViewer
                            x:Name="UnrealSyncScrollViewer"
                            Grid.Row="2"
                            VerticalScrollBarVisibility="Auto">
                            <Grid
                                Background="Transparent"
                                ColumnSpacing="12"
                                Tapped="UnrealSyncBlankArea_Tapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="12">
                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <Grid Padding="16" RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="基础信息" />
                                            <TextBox
                                                x:Name="CharacterCodeTextBox"
                                                Grid.Row="1"
                                                Header="英文代号"
                                                                                  
                                                                                          
                                                Margin="0,0,128,0"
                                                Text="{Binding UnrealSync.Code, Mode=OneWay}" />
                                            <Button
                                                Grid.Row="1"
                                                MinWidth="116"
                                                Margin="0,28,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Click="ApplyCharacterCodeButton_Click"
                                                Content="确定修改"
                                                Style="{StaticResource PrimaryToolButtonStyle}" />
                                            <TextBox
                                                Grid.Row="2"
                                                Header="名称"
                                                                                  
                                                                                          
                                                Text="{Binding UnrealSync.CharacterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox
                                                Grid.Row="3"
                                                MinHeight="112"
                                                AcceptsReturn="True"
                                                Header="介绍"
                                                                                  
                                                                                          
                                                Text="{Binding UnrealSync.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Row="4"
                                                Style="{StaticResource SubtleTextStyle}"
                                                Text="{Binding UnrealSync.StatusText, Mode=OneWay}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <Border.Resources>
                                            <DataTemplate x:Key="KeywordTagCategoryTemplate">
                                                <Grid
                                                    Margin="0,0,0,16"
                                                    RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding DisplayName, Mode=OneWay}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Click="AddKeywordTagButton_Click"
                                                            Style="{StaticResource CompactIconButtonStyle}"
                                                            ToolTipService.ToolTip="在此分类新增 Tag"
                                                            Visibility="{Binding CanAdd, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                                            <SymbolIcon Symbol="Add" />
                                                        </Button>
                                                    </Grid>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Entries, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox
                                                                        IsReadOnly="{Binding IsReadOnly, Mode=OneWay}"
                                                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <Button
                                                                        Grid.Column="1"
                                                                        Click="RemoveKeywordTagButton_Click"
                                                                        IsEnabled="{Binding CanRemove, Mode=OneWay}"
                                                                        Style="{StaticResource CompactIconButtonStyle}"
                                                                        ToolTipService.ToolTip="删除此 Tag"
                                                                        Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                                        <SymbolIcon Symbol="Delete" />
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </Border.Resources>
                                        <Grid Padding="16" RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="关键词 Tag" />
                                            <ItemsControl
                                                Grid.Row="1"
                                                HorizontalContentAlignment="Stretch"
                                                ItemTemplate="{StaticResource KeywordTagCategoryTemplate}"
                                                ItemsSource="{Binding UnrealSync.KeywordTagCategories, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <Grid Padding="16" RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="被动技能" />
                                                <Button
                                                    Grid.Column="1"
                                                    Click="AddPassiveSkillButton_Click"

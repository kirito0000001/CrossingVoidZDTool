                                                    IsEnabled="{Binding UnrealProjectSync.IsWorkflowOperationIdle, Mode=OneWay}"
                                                    ToolTipService.ToolTip="从当前步骤往后依次检测，停在第一个需要处理的步骤；只检测，不写入" />
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    Click="ReloadUnrealWorkflowStepButton_Click"
                                                    Content="{Binding UnrealProjectSync.WorkflowReloadText, Mode=OneWay}"
                                                    IsEnabled="{Binding UnrealProjectSync.IsWorkflowOperationIdle, Mode=OneWay}"
                                                    Visibility="{Binding UnrealProjectSync.PublishWorkspaceVisibility, Mode=OneWay}" />
                                             </StackPanel>
                                            <StackPanel Spacing="8" Visibility="{Binding UnrealProjectSync.FoundationDetailsVisibility, Mode=OneWay}">
                                                <TextBlock FontWeight="SemiBold" Text="底层检测" />
                                                <ToggleSwitch Header="隐藏已处理" IsOn="{Binding UnrealProjectSync.HideCompletedFoundationChecks, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Spacing="8" Visibility="{Binding UnrealProjectSync.SequenceSynchronizationDetailsVisibility, Mode=OneWay}">
                                                <TextBlock FontWeight="SemiBold" Text="序列同步" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="只显示序列、帧素材、AnimMaps 和语音轨道的差异。" TextWrapping="Wrap" />
                                            </StackPanel>
                                     <StackPanel
                                        x:Name="UnrealImportWorkspacePanel"
                                        Spacing="10"
                                        Visibility="{Binding UnrealProjectSync.ImportWorkspaceVisibility, Mode=OneWay}">
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="内容导入" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.ContentDetectionStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding UnrealProjectSync.ImportOperationTitle, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.ImportOperationMessage, Mode=OneWay}" TextWrapping="Wrap" />
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    Click="DetectUnrealImportButton_Click"
                                                    Content="检测所选角色"
                                                    IsEnabled="{Binding UnrealProjectSync.CanDetectSelectedSource, Mode=OneWay}" />

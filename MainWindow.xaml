                                                OnContent="异能" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <Grid Padding="16" RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="数值" />
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding UnrealSync.Stats, Mode=OneWay}">

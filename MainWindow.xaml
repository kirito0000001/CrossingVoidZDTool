                                <DataTemplate>
                                    <Button
                                        Width="150"
                                        Margin="0,0,12,0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="SkillIconPickerItem_Click"
                                        Tag="{Binding}">
                                        <StackPanel Spacing="8">
                                            <Border
                                                Width="150"
                                                Height="190"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Image
                                                    Margin="10"
                                                    Source="{Binding Item.FileUri, Mode=OneWay}"
                                                    Stretch="Uniform" />
                                            </Border>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Item.FileName, Mode=OneWay}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                            <CheckBox
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding IsSelected, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border
                        Grid.Row="2"
                        Padding="30,18"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Click="SkillIconPickerConfirmButton_Click"
                                Content="确定"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource DialogAccentButtonStyle}" />
                            <Button
                                Grid.Column="1"
                                Click="SkillIconPickerCancelButton_Click"
                                Content="取消"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PrimaryToolButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="SequenceFramesManagerHost"
            Grid.RowSpan="2"
            Background="#8C000000"
            Canvas.ZIndex="169"
            IsTabStop="True"
            KeyDown="SequenceFramesManagerHost_KeyDown"
            Tapped="SequenceFramesManagerHost_Tapped"
            Visibility="Collapsed">
            <Border
                x:Name="SequenceFramesManagerCard"
                Width="1280"
                MaxHeight="840"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                RenderTransformOrigin="0.5,0.5"
                Tapped="SequenceFramesManagerCard_Tapped">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SequenceFramesManagerCardScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <Grid Padding="20" ColumnSpacing="14" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SequenceFrames.SelectedSectionTitle, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding SequenceFrames.EditorSequenceSummary, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Click="OpenSequenceCollectionButton_Click"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="检查全部帧素材与重复图片">
                            <SymbolIcon Symbol="Bullets" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Click="SequenceFramesManagerCloseButton_Click"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="关闭">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Click="PreviousSequenceFrameButton_Click" Style="{StaticResource IconToolButtonStyle}" ToolTipService.ToolTip="上一帧">
                                    <FontIcon Glyph="&#xE892;" />
                                </Button>
                                <Button Grid.Column="1" Click="PlayPauseSequenceEditorPreviewButton_Click" Style="{StaticResource IconToolButtonStyle}" ToolTipService.ToolTip="{Binding SequenceFrames.PlayPauseToolTip, Mode=OneWay}">
                                    <FontIcon Glyph="{Binding SequenceFrames.PlayPauseGlyph, Mode=OneWay}" />
                                </Button>
                                <Button Grid.Column="2" Click="NextSequenceFrameButton_Click" Style="{StaticResource IconToolButtonStyle}" ToolTipService.ToolTip="下一帧">
                                    <FontIcon Glyph="&#xE893;" />
                                </Button>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="FPS" />
                                <NumberBox
                                    x:Name="SequencePreviewFpsStepper"
                                    Grid.Column="4"
                                    Width="150"
                                    Maximum="60"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{Binding SequenceFrames.PreviewFps, Mode=TwoWay}" />
                                <ToggleSwitch
                                    x:Name="SequenceEditorPlaybackModeToggle"
                                    Grid.Column="5"
                                    VerticalAlignment="Center"
                                    IsOn="{Binding SequenceFrames.IsEditorPlaybackLoop, Mode=TwoWay}"
                                    OffContent="播放一次"
                                    OnContent="循环播放" />
                                <ToggleSwitch
                                    x:Name="SequenceEditorPauseWhenVoiceEndsToggle"
                                    Grid.Column="6"
                                    VerticalAlignment="Center"
                                    IsOn="{Binding SequenceFrames.PauseEditorPreviewWhenVoiceEnds, Mode=TwoWay}"
                                    OffContent="语音结束继续"
                                    OnContent="语音结束暂停" />
                                <Grid Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="SequenceEditorSingleFrameText"
                                        Width="88"
                                        TextAlignment="Right"
                                        Style="{StaticResource SubtleTextStyle}"
                                        Text="{Binding SequenceFrames.EditorPlaybackPositionText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="SequenceEditorMultiSelectionText"
                                        Style="{StaticResource SubtleTextStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                            <Border
                                Grid.Row="1"
                                MinHeight="330"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid
                                    x:Name="SequenceEditorPreviewCanvas"
                                    Background="Transparent"
                                    DoubleTapped="SequenceEditorPreviewCanvas_DoubleTapped"
                                    PointerCanceled="SequenceEditorPreviewCanvas_PointerCanceled"
                                    PointerCaptureLost="SequenceEditorPreviewCanvas_PointerCaptureLost"
                                    PointerMoved="SequenceEditorPreviewCanvas_PointerMoved"
                                    PointerPressed="SequenceEditorPreviewCanvas_PointerPressed"
                                    PointerReleased="SequenceEditorPreviewCanvas_PointerReleased"
                                    PointerWheelChanged="SequenceEditorPreviewCanvas_PointerWheelChanged">
                                    <controls:BufferedImagePresenter
                                        x:Name="SequenceEditorPreviewPresenter"
                                        RenderTransformOrigin="0.5,0.5">
                                        <controls:BufferedImagePresenter.RenderTransform>
                                            <CompositeTransform x:Name="SequenceEditorPreviewImageTransform" />
                                        </controls:BufferedImagePresenter.RenderTransform>
                                    </controls:BufferedImagePresenter>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource SubtleTextStyle}"
                                        Text="空白帧"
                                        Visibility="{Binding SequenceFrames.CurrentPreviewFrame.BlankVisibility, Mode=OneWay}" />
                                </Grid>
                            </Border>
                    </Grid>

                    <Border
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Padding="14"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ScrollViewer
                                x:Name="SequenceFrameInspectorScrollViewer"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Auto">
                                <Grid>
                                    <StackPanel x:Name="SequenceSingleFramePanel" Spacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="当前帧" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding SequenceFrames.EditorSelectedFrameText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border
                                            Padding="10"
                                            Background="{Binding SequenceFrames.SelectedEditorFrame.ReuseTintBrush, Mode=OneWay}"
                                            BorderBrush="{Binding SequenceFrames.SelectedEditorFrame.ReuseBrush, Mode=OneWay}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding SequenceFrames.SelectedEditorFrame.ReuseVisibility, Mode=OneWay}">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Foreground="{Binding SequenceFrames.SelectedEditorFrame.ReuseBrush, Mode=OneWay}" Text="素材复用" />
                                                <TextBlock Text="{Binding SequenceFrames.SelectedEditorFrame.ReuseCurrentUsageText, Mode=OneWay}" />
                                                <TextBlock Text="{Binding SequenceFrames.SelectedEditorFrame.ReuseSourceText, Mode=OneWay}" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding SequenceFrames.SelectedEditorFrame.ReuseAllPositionsText, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Spacing="8">
                                            <Button HorizontalAlignment="Stretch" Click="NewSequenceEditorFrameButton_Click" Content="新建帧" Style="{StaticResource PrimaryToolButtonStyle}" />
                                            <Button HorizontalAlignment="Stretch" Click="ReplaceSequenceEditorFrameButton_Click" Content="替换帧素材" IsEnabled="{Binding SequenceFrames.HasSelectedEditorFrame, Mode=OneWay}" Style="{StaticResource PrimaryToolButtonStyle}" />
                                            <Button HorizontalAlignment="Stretch" Click="SelectSequenceEditorFrameFromCollectionButton_Click" Content="从帧合集选择" IsEnabled="{Binding SequenceFrames.HasSelectedEditorFrame, Mode=OneWay}" Style="{StaticResource PrimaryToolButtonStyle}" />
                                        </StackPanel>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="持续帧格" />
                                            <NumberBox
                                                x:Name="SequenceFrameDurationStepper"
                                                Minimum="1"
                                                Maximum="600"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding SequenceFrames.EditorFrameDurationInput, Mode=TwoWay}"
                                                ValueChanged="SequenceFrameDurationStepper_ValueChanged" />
                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding SequenceFrames.EditorFrameDurationText, Mode=OneWay}" />
                                        </StackPanel>
                                         <StackPanel Spacing="5">
                                             <TextBlock Text="当前帧语音" />
                                            <ComboBox
                                                x:Name="SequenceFrameVoiceComboBox"
                                                HorizontalAlignment="Stretch"
                                                 DisplayMemberPath="DisplayName"
                                                 ItemsSource="{Binding SequenceFrames.AvailableVoices, Mode=OneWay}"
                                                 SelectedItem="{Binding SequenceFrames.SelectedEditorVoiceOption, Mode=OneWay}"
                                                  SelectionChanged="SequenceFrameVoiceComboBox_SelectionChanged" />
                                         </StackPanel>
                                        <Grid
                                            x:Name="SequenceVoiceSyncInspector"
                                            ColumnSpacing="8"
                                            Visibility="{Binding SequenceFrames.SelectedEditorFrame.VoiceSyncVisibility, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Background="{Binding SequenceFrames.SelectedEditorFrame.VoiceSyncBrush, Mode=OneWay}"
                                                CornerRadius="2" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="语音同步" />
                                                <TextBlock Text="{Binding SequenceFrames.SelectedEditorFrame.VoiceSyncDurationText, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SequenceFrames.SelectedEditorFrame.VoiceSyncAvailableText, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding SequenceFrames.SelectedEditorFrame.VoiceSyncBrush, Mode=OneWay}"
                                                    Text="{Binding SequenceFrames.SelectedEditorFrame.VoiceSyncStatusText, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SubtleTextStyle}"
                                                    Text="{Binding SequenceFrames.SelectedEditorFrame.VoiceSyncSuggestionText, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{Binding SequenceFrames.SelectedEditorFrame.VoiceSyncSuggestionVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button HorizontalAlignment="Stretch" Click="CopySequenceEditorFrameButton_Click" Content="复制" IsEnabled="{Binding SequenceFrames.HasSelectedEditorFrame, Mode=OneWay}" Style="{StaticResource PrimaryToolButtonStyle}" />
                                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="InsertBlankSequenceFrameBeforeButton_Click" Content="左插入" IsEnabled="{Binding SequenceFrames.HasSelectedEditorFrame, Mode=OneWay}" Style="{StaticResource PrimaryToolButtonStyle}" />
                                            <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="InsertBlankSequenceFrameAfterButton_Click" Content="右插入" IsEnabled="{Binding SequenceFrames.HasSelectedEditorFrame, Mode=OneWay}" Style="{StaticResource PrimaryToolButtonStyle}" />
                                            <Button Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Click="DeleteSequenceEditorFrameButton_Click" Content="删除当前帧" IsEnabled="{Binding SequenceFrames.HasSelectedEditorFrame, Mode=OneWay}" Style="{StaticResource PrimaryToolButtonStyle}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="SequenceMultiFramePanel" Spacing="14" Visibility="Collapsed">
                                        <StackPanel Spacing="3">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="批量操作" />
                                            <TextBlock x:Name="SequenceMultiSelectionSummaryText" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="所选帧" />
                                            <TextBlock x:Name="SequenceMultiSelectionFramesText" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SequenceMultiSelectionDurationText" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SequenceMultiSelectionVoiceText" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="DuplicateSelectedSequenceFramesButton" HorizontalAlignment="Stretch" Click="DuplicateSelectedSequenceFramesButton_Click" Content="复制所选帧" Style="{StaticResource PrimaryToolButtonStyle}" />
                                        <Button x:Name="DeleteSelectedSequenceFramesButton" HorizontalAlignment="Stretch" Click="DeleteSelectedSequenceFramesButton_Click" Content="删除所选帧" Style="{StaticResource PrimaryToolButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" Grid.Column="0" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock FontWeight="SemiBold" Text="帧时间轴" />
                            </StackPanel>
                            <TextBlock x:Name="SequenceTimelineModeText" Grid.Column="1" Style="{StaticResource SubtleTextStyle}" Text="拖动帧块排序" />
                        </Grid>
                        <ListView
                            x:Name="SequenceFrameTimelineListView"
                            Grid.Row="1"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            DragItemsCompleted="SequenceFrameManagerGridView_DragItemsCompleted"
                            DragItemsStarting="SequenceFrameManagerGridView_DragItemsStarting"
                            IsItemClickEnabled="True"
                            ItemClick="SequenceFrameTimelineListView_ItemClick"
                            ItemsSource="{Binding SequenceFrames.SelectedSectionFrames, Mode=OneWay}"
                            KeyDown="SequenceFrameTimelineListView_KeyDown"
                            ReorderMode="Enabled"
                            SelectionChanged="SequenceFrameTimelineListView_SelectionChanged"
                            SelectionMode="Extended"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="SequenceTimelineFrameCard"
                                        Width="{Binding TimelineWidth, Mode=OneWay}"
                                        Height="150"
                                        Padding="8"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="替换素材" Click="ReplaceSequenceFrameMenuItem_Click" Tag="{Binding}" />
                                                <MenuFlyoutItem Text="复制" Click="CopySequenceFrameMenuItem_Click" Tag="{Binding}" />
                                                <MenuFlyoutItem Text="左插入" Click="InsertBlankSequenceFrameBeforeMenuItem_Click" Tag="{Binding}" />
                                                <MenuFlyoutItem Text="右插入" Click="InsertBlankSequenceFrameAfterMenuItem_Click" Tag="{Binding}" />
                                                <MenuFlyoutItem Text="删除" Click="DeleteSequenceFrameMenuItem_Click" Tag="{Binding}" />
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <StackPanel Spacing="5">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Index, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource SubtleTextStyle}" Text="{Binding DurationText, Mode=OneWay}" />
                                            </Grid>
                                            <Grid
                                                x:Name="SequenceTimelineFrameThumbnail"
                                                Height="96"
                                                Background="{ThemeResource LayerFillColorAltBrush}">
                                                <Image Source="{Binding FileUri, Mode=OneWay}" Stretch="Uniform" />
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" Text="空白帧" Visibility="{Binding BlankVisibility, Mode=OneWay}" />
                                                <Border
                                                    BorderBrush="{Binding ReuseBrush, Mode=OneWay}"
                                                    BorderThickness="2"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding ReuseVisibility, Mode=OneWay}" />
                                                <Button
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Margin="4"
                                                    Padding="5,2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="{Binding ReuseTintBrush, Mode=OneWay}"
                                                    BorderBrush="{Binding ReuseBrush, Mode=OneWay}"
                                                    BorderThickness="1"
                                                    Click="SelectSequenceReuseGroupButton_Click"
                                                    CornerRadius="3"
                                                    ToolTipService.ToolTip="选择所有使用此素材的帧"
                                                    Visibility="{Binding ReuseVisibility, Mode=OneWay}">
                                                     <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{Binding ReuseBrush, Mode=OneWay}" Text="{Binding ReuseBadgeText, Mode=OneWay}" />
                                                 </Button>
                                                <Border
                                                    x:Name="SequenceTimelineVoiceMarker"
                                                    Width="28"
                                                    Height="26"
                                                    Margin="4"
                                                    Padding="5,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    CornerRadius="3"
                                                    ToolTipService.ToolTip="{Binding VoiceFileName, Mode=OneWay}"
                                                    Visibility="{Binding VoiceVisibility, Mode=OneWay}">
                                                    <FontIcon FontSize="14" Glyph="&#xE767;" />
                                                </Border>
                                                <Border
                                                    x:Name="SequenceTimelineSyncMarker"
                                                    Margin="4"
                                                    Padding="6,3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Background="{Binding VoiceSyncTintBrush, Mode=OneWay}"
                                                    BorderBrush="{Binding VoiceSyncBrush, Mode=OneWay}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Visibility="{Binding VoiceSyncVisibility, Mode=OneWay}">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding VoiceSyncBrush, Mode=OneWay}"
                                                        Text="{Binding VoiceSyncBadgeText, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </Grid>
                                         </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="VoiceMaterialManagerHost"
            Grid.RowSpan="2"
            Background="#8C000000"
            Canvas.ZIndex="168"
            IsTabStop="True"
            KeyDown="VoiceMaterialManagerHost_KeyDown"
            RightTapped="VoiceMaterialManagerHost_RightTapped"
            Tapped="VoiceMaterialManagerHost_Tapped"
            Visibility="Collapsed">
            <Border
                x:Name="VoiceMaterialManagerCard"
                Width="860"
                MaxHeight="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                RenderTransformOrigin="0.5,0.5"
                RightTapped="VoiceMaterialManagerHost_RightTapped"
                Tapped="VoiceMaterialManagerCard_Tapped">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="VoiceMaterialManagerCardScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <Grid Padding="24" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="VoiceMaterialManagerTitleText"
                                FontSize="20"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="VoiceMaterialManagerStatusText"
                                Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Click="VoiceMaterialManagerCloseButton_Click"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="关闭">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>
                    <Grid
                        x:Name="VoiceMaterialAssignmentBar"
                        Grid.Row="1"
                        ColumnSpacing="12"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="VoiceMaterialManagerSelectionText"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtleTextStyle}"
                            Text="请选择要分配的语音" />
                        <Button
                            x:Name="CheckVoiceMaterialDuplicatesButton"
                            Grid.Column="1"
                            Click="CheckVoiceMaterialDuplicatesButton_Click"
                            Content="检查重复"
                            Style="{StaticResource PrimaryToolButtonStyle}" />
                        <Button
                            x:Name="ShowAllVoiceMaterialsButton"
                            Grid.Column="2"
                            Click="ShowAllVoiceMaterialsButton_Click"
                            Content="显示全部"
                            Style="{StaticResource PrimaryToolButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="AssignVoiceMaterialsButton"
                            Grid.Column="3"
                            Click="AssignVoiceMaterialsButton_Click"
                            Content="分配到"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryToolButtonStyle}" />
                    </Grid>
                    <ListView
                        x:Name="VoiceMaterialManagerListView"
                        Grid.Row="2"
                        ItemTemplate="{StaticResource VoiceMaterialManagerItemTemplate}"
                        SelectionChanged="VoiceMaterialManagerListView_SelectionChanged"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="SequenceFramesCollectionHost"
            Grid.RowSpan="2"
            Background="#8C000000"
            Canvas.ZIndex="170"
            IsTabStop="True"
            KeyDown="SequenceFramesCollectionHost_KeyDown"
            Tapped="SequenceFramesCollectionHost_Tapped"
            Visibility="Collapsed">
            <Border
                x:Name="SequenceFramesCollectionCard"
                Width="1100"
                MaxHeight="780"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                RenderTransformOrigin="0.5,0.5"
                Tapped="SequenceFramesCollectionCard_Tapped">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SequenceFramesCollectionCardScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <Grid Padding="24" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="SequenceFramesCollectionTitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="帧合集" />
                            <TextBlock
                                x:Name="SequenceFramesCollectionSelectionHintText"
                                Style="{StaticResource SubtleTextStyle}"
                                Text="点击一张图片，将其设为当前帧素材。"
                                Visibility="Collapsed" />
                            <TextBlock
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding SequenceFrames.CollectionSummaryText, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            x:Name="DetectSequenceFrameDuplicatesButton"
                            Grid.Column="1"
                            Click="DetectSequenceFrameDuplicatesButton_Click"
                            Content="检测重复"
                            Style="{StaticResource PrimaryToolButtonStyle}" />
                        <Button
                            x:Name="ResolveAllSequenceFrameDuplicatesButton"
                            Grid.Column="2"
                            Click="ResolveAllSequenceFrameDuplicatesButton_Click"
                            Content="一键处理"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryToolButtonStyle}" />
                        <Button
                            Grid.Column="3"
                            Click="SequenceFramesCollectionCloseButton_Click"
                            Style="{StaticResource IconToolButtonStyle}"
                            ToolTipService.ToolTip="关闭">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>
                     <GridView
                         x:Name="SequenceFramesCollectionGridView"
                         Grid.Row="1"
                         IsItemClickEnabled="True"
                         ItemClick="SequenceFramesCollectionGridView_ItemClick"
                         ItemsSource="{Binding SequenceFrames.CollectionItems, Mode=OneWay}"
                         SelectionChanged="SequenceFramesCollectionGridView_SelectionChanged"
                         SelectionMode="None">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid ItemHeight="234" ItemWidth="206" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="196"
                                    Height="224"
                                    Padding="10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    DoubleTapped="SequenceFrameCollectionItem_DoubleTapped">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="ResolveDuplicateSequenceFrameMenuItem_Click"
                                                Tag="{Binding}"
                                                Text="处理重复" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                MaxLines="2"
                                                Text="{Binding UsageText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <Border
                                                    Padding="8,3"
                                                    Background="#335B8DEF"
                                                    CornerRadius="4"
                                                    Visibility="{Binding ReuseVisibility, Mode=OneWay}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFB7D5FF"
                                                        Text="复用" />
                                                </Border>
                                                <Border
                                                    Padding="8,3"
                                                    Background="#33D83B01"
                                                    CornerRadius="4"
                                                    Visibility="{Binding DuplicateVisibility, Mode=OneWay}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFFFB4A9"
                                                        Text="重复" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Border
                                            Height="124"
                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Grid>
                                                <Image Source="{Binding FileUri, Mode=OneWay}" Stretch="Uniform" />
                                                <Border
                                                    MinWidth="28"
                                                    Height="28"
                                                    Margin="6"
                                                    Padding="7,2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{Binding SelectionOrderVisibility, Mode=OneWay}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Text="{Binding SelectionOrderText, Mode=OneWay}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            Style="{StaticResource SubtleTextStyle}"
                                            Text="{Binding StatusText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Style="{StaticResource SubtleTextStyle}"
                                            Text="{Binding FileName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding FileName, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtleTextStyle}"
                            Text="点击“检测重复”后按图片像素内容判断；文件名、编码和元数据不同，但最终像素完全一致时会标记。" />
                        <Button
                            x:Name="CancelSequenceFrameCollectionSelectionButton"
                            Grid.Column="1"
                            Click="CancelSequenceFrameCollectionSelectionButton_Click"
                            Content="取消"
                            Style="{StaticResource PrimaryToolButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="ConfirmSequenceFrameCollectionSelectionButton"
                            Grid.Column="2"
                            Click="ConfirmSequenceFrameCollectionSelectionButton_Click"
                            Content="确定"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryToolButtonStyle}"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="SequenceFrameDuplicateResolverHost"
            Grid.RowSpan="2"
            Background="#8C000000"
            Canvas.ZIndex="172"
            IsTabStop="True"
            KeyDown="SequenceFrameDuplicateResolverHost_KeyDown"
            RightTapped="SequenceFrameDuplicateResolverHost_RightTapped"
            Tapped="SequenceFrameDuplicateResolverHost_Tapped"
            Visibility="Collapsed">
            <Border
                x:Name="SequenceFrameDuplicateResolverCard"
                Width="760"
                MaxHeight="740"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                RenderTransformOrigin="0.5,0.5"
                RightTapped="SequenceFrameDuplicateResolverCard_RightTapped"
                Tapped="SequenceFrameDuplicateResolverCard_Tapped">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SequenceFrameDuplicateResolverCardScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <Grid Padding="24" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="处理重复帧" />
                        <TextBlock
                            x:Name="SequenceFrameDuplicateResolverStatusText"
                            Style="{StaticResource SubtleTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SequenceFrameDuplicateResolverItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton
                                        Margin="0,0,0,10"
                                        Checked="SequenceFrameDuplicateResolverRadioButton_Checked"
                                        GroupName="DuplicateFrameResolver"
                                        Tag="{Binding}">
                                        <Border
                                            Width="660"
                                            Padding="10"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Height="108"
                                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                                    CornerRadius="4">
                                                    <Image Source="{Binding FileUri, Mode=OneWay}" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding FileName, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource SubtleTextStyle}"
                                                        Text="{Binding StatusText, Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource SubtleTextStyle}"
                                                        Text="{Binding UsageText, Mode=OneWay}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Click="SequenceFrameDuplicateResolverCancelButton_Click"
                            Content="返回"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource PrimaryToolButtonStyle}" />
                        <Button
                            Grid.Column="1"
                            Click="SequenceFrameDuplicateResolverConfirmButton_Click"
                            Content="确认保留所选"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource DialogAccentButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="BaseMaterialCropHost"
            Grid.RowSpan="2"
            Background="#8C000000"
            Canvas.ZIndex="180"
            IsTabStop="True"
            KeyDown="BaseMaterialCropHost_KeyDown"
            RightTapped="BaseMaterialCropHost_RightTapped"
            Visibility="Collapsed">
            <Border
                Width="760"
                MaxHeight="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="30,24,30,14" Spacing="4">
                        <TextBlock
                            x:Name="BaseMaterialCropTitleText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="裁剪素材" />
                        <TextBlock
                            x:Name="BaseMaterialCropSubtitleText"
                            Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="30,0,30,24">
                        <Border
                            x:Name="BaseMaterialCropPreviewFrame"
                            Width="460"
                            Height="460"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#202020"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            DoubleTapped="BaseMaterialCropPreviewFrame_DoubleTapped"
                            PointerCanceled="BaseMaterialCropPreviewFrame_PointerCanceled"
                            PointerCaptureLost="BaseMaterialCropPreviewFrame_PointerCaptureLost"
                            PointerMoved="BaseMaterialCropPreviewFrame_PointerMoved"
                            PointerPressed="BaseMaterialCropPreviewFrame_PointerPressed"
                            PointerReleased="BaseMaterialCropPreviewFrame_PointerReleased"
                            PointerWheelChanged="BaseMaterialCropPreviewFrame_PointerWheelChanged"
                            RightTapped="BaseMaterialCropPreviewFrame_RightTapped">
                            <Grid>
                                <Image
                                    x:Name="BaseMaterialCropImage"
                                    HorizontalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5"
                                    Stretch="Fill"
                                    VerticalAlignment="Center">
                                    <Image.RenderTransform>
                                        <CompositeTransform x:Name="BaseMaterialCropImageTransform" />
                                    </Image.RenderTransform>
                                </Image>
                                <Grid IsHitTestVisible="False">
                                    <Rectangle
                                        x:Name="BaseMaterialCropMaskTop"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Fill="#80000000" />
                                    <Rectangle
                                        x:Name="BaseMaterialCropMaskBottom"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Fill="#80000000" />
                                    <Rectangle
                                        x:Name="BaseMaterialCropMaskLeft"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Fill="#80000000" />
                                    <Rectangle
                                        x:Name="BaseMaterialCropMaskRight"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Fill="#80000000" />
                                </Grid>
                                <Image
                                    x:Name="SupportCutInCropMask"
                                    Width="{Binding ElementName=BaseMaterialCropTargetFrame, Path=Width}"
                                    Height="{Binding ElementName=BaseMaterialCropTargetFrame, Path=Height}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Opacity="0.28"
                                    Source="ms-appx:///Assets/SupportCutInCropMask.png"
                                    Stretch="Fill"
                                    Visibility="Collapsed" />
                                <Border
                                    x:Name="BaseMaterialCropTargetFrame"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="#E6000000"
                                    BorderThickness="2"
                                    CornerRadius="2"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Padding="30,18"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Click="BaseMaterialCropConfirmButton_Click"
                                Content="确定裁剪"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource DialogAccentButtonStyle}" />
                            <Button
                                Grid.Column="1"
                                Click="BaseMaterialCropCancelButton_Click"
                                Content="取消"
                                HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


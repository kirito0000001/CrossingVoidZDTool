                                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                    <TextBlock FontWeight="SemiBold" Text="最近执行结果" />
                                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.ImportResultMessage, Mode=OneWay}" TextWrapping="Wrap" />

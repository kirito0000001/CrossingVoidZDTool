                                                                    <TextBlock VerticalAlignment="Center" Margin="0" Padding="0" MaxLines="1" Style="{StaticResource SubtleTextStyle}" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding DetailText}" LineHeight="18" LineStackingStrategy="BlockLineHeight" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" MinWidth="52" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" Text="{Binding StatusText}" TextAlignment="Right" TextWrapping="NoWrap" />
                                                            </Grid>
                                                        </Expander.Header>
                                                        <StackPanel Spacing="4">
                                                            <StackPanel Visibility="{Binding IsSequenceGroup, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" Spacing="4">
                                                                <Border Margin="0,0,18,4" Padding="8,6" Style="{StaticResource LogErrorBlockStyle}">
                                                                    <TextBlock Style="{StaticResource LogErrorTextStyle}" Text="{Binding DeleteCountText}" />
                                                                </Border>
                                                                <Border Margin="0,0,18,0" Padding="8,6" Style="{StaticResource LogDefaultBlockStyle}">
                                                                    <TextBlock Style="{StaticResource LogDefaultTextStyle}" Text="{Binding AddCountText}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <ItemsControl ItemsSource="{Binding VisibleChildren}" Visibility="{Binding IsSequenceGroup, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}">
                                                                <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid MinHeight="52" Margin="0,0,0,3" Padding="4,4,6,4" ColumnSpacing="6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox Width="24" MinWidth="24" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}" Click="UnrealSyncSelectionCheckBox_Click" />
                                                                        <Grid Grid.Column="1" MinWidth="0" VerticalAlignment="Center" RowSpacing="2">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <TextBlock MaxLines="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding DisplayName}" />
                                                                            <TextBlock Grid.Row="1" MaxLines="1" Style="{StaticResource SubtleTextStyle}" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding DetailText}" />
                                                                        </Grid>
                                                                        <TextBlock Grid.Column="2" MinWidth="52" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" Text="{Binding StatusText}" TextAlignment="Right" TextWrapping="NoWrap" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                     <Grid
                                         Grid.Row="1"
                                         Visibility="{Binding UnrealProjectSync.IsNormalizationWorkspace, Mode=OneWay}">
                                         <ListView
                                             ItemsSource="{Binding UnrealProjectSync.VisibleNormalizationItems, Mode=OneWay}"
                                            SelectionMode="None"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="14,0,14,8" Padding="12" Style="{StaticResource PanelBorderStyle}" Visibility="{Binding ItemVisibility, Mode=OneWay}">
                                                            <Grid ColumnSpacing="16" RowSpacing="10">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock FontSize="12" Style="{StaticResource SubtleTextStyle}" Text="来源：Unreal" />
                                                                    <Grid ColumnSpacing="10">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="96" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid Width="96" Height="92" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                                        <Image Source="{Binding FileUri, Mode=OneWay}" Stretch="Uniform" Visibility="{Binding ImageVisibility, Mode=OneWay}" />
                                                                        <Button HorizontalAlignment="Center" VerticalAlignment="Center" Click="PreviewUnrealNormalizationAudioButton_Click" Content="试听" Tag="{Binding}" Visibility="{Binding AudioVisibility, Mode=OneWay}" />
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" Text="无预览" Visibility="{Binding MissingPreviewVisibility, Mode=OneWay}" />
                                                                        </Grid>
                                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding UnrealAssetName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding UnrealAssetName}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <TextBlock FontSize="12" Style="{StaticResource SubtleTextStyle}" Text="来源：工具箱" />
                                                                    <Grid ColumnSpacing="10">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="96" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid Width="96" Height="92" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                                        <Image Source="{Binding SelectedCandidateFileUri, Mode=OneWay}" Stretch="Uniform" Visibility="{Binding SelectedCandidateVisibility, Mode=OneWay}" />
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" Text="未选择" Visibility="{Binding PendingCandidateVisibility, Mode=OneWay}" />
                                                                        </Grid>
                                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SelectedCandidateName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SelectedCandidateName}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button HorizontalAlignment="Stretch" Click="SkipUnrealNormalizationButton_Click" Content="不需要重定向" Tag="{Binding}" />
                                                                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="ClearUnrealNormalizationRedirectButton_Click" Content="清空重定向" Tag="{Binding}" />
                                                                    <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="ChooseUnrealNormalizationRedirectButton_Click" Content="选择重定向素材" Tag="{Binding}" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                                <Grid Padding="14" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="操作与结果" />
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="{Binding UnrealProjectSync.SelectedSource.DisplayName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding UnrealProjectSync.SelectedSource.DisplayName, Mode=OneWay}" />
                                    </StackPanel>
                                    <ScrollViewer
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="6">
                                                <TextBlock FontWeight="SemiBold" Text="同步流程" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="16" Text="1" />
                                                    <TextBlock Grid.Column="1" Text="底层检测" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.WorkflowStep1StatusText, Mode=OneWay}" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="16" Text="2" />
                                                    <TextBlock Grid.Column="1" Text="规整素材" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.WorkflowStep2StatusText, Mode=OneWay}" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="16" Text="3" />
                                                    <TextBlock Grid.Column="1" Text="同步素材" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.WorkflowStep3StatusText, Mode=OneWay}" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="16" Text="4" />
                                                    <TextBlock Grid.Column="1" Text="基础配置" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.WorkflowStep4StatusText, Mode=OneWay}" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="16" Text="5" />
                                                    <TextBlock Grid.Column="1" Text="序列同步" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.WorkflowStep5StatusText, Mode=OneWay}" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="16" Text="6" />
                                                    <TextBlock Grid.Column="1" Text="蓝图置入" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.WorkflowStep6StatusText, Mode=OneWay}" />
                                                </Grid>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        MinHeight="42"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Click="UnrealSyncPreviousStepButton_Click"
                                                        Content="上一步"
                                                        IsEnabled="{Binding UnrealProjectSync.IsWorkflowOperationIdle, Mode=OneWay}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        MinHeight="42"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Click="UnrealSyncNextStepButton_Click"
                                                        Content="{Binding UnrealProjectSync.WorkflowNextText, Mode=OneWay}"

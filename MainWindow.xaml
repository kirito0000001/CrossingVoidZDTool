                                                        <TextBlock Grid.Row="2" Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.ImportDeletedCountText, Mode=OneWay}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource SubtleTextStyle}" Text="重复导入会更新原素材" TextWrapping="Wrap" />
                                                    </Grid>
                                                    <Button
                                                        HorizontalAlignment="Stretch"
                                                        Click="ImportSelectedUnrealCharacterToDraftButton_Click"
                                                        Content="{Binding UnrealProjectSync.ImportPrimaryActionText, Mode=OneWay}"
                                                        IsEnabled="{Binding UnrealProjectSync.CanImportSelection, Mode=OneWay}"
                                                        Style="{StaticResource AccentButtonStyle}" />
                                                </StackPanel>
                                                <StackPanel Spacing="4" Visibility="{Binding UnrealProjectSync.ImportResultVisibility, Mode=OneWay}">
                                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                    <TextBlock FontWeight="SemiBold" Text="最近执行结果" />
                                                    <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.ImportResultMessage, Mode=OneWay}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel
                                                x:Name="UnrealPublishWorkspacePanel"
                                                Spacing="10"
                                                Visibility="{Binding UnrealProjectSync.PublishWorkspaceVisibility, Mode=OneWay}">
                                                <StackPanel
                                                    Spacing="6"
                                                    Visibility="{Binding UnrealProjectSync.StepSelectionVisibility, Mode=OneWay}">
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding UnrealProjectSync.StepSelectionText, Mode=OneWay}" />
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Click="UnrealSyncSelectAllButton_Click"
                                                            Content="全选"
                                                            IsEnabled="{Binding UnrealProjectSync.CanChangeStepSelection, Mode=OneWay}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Click="UnrealSyncSelectNoneButton_Click"
                                                            Content="全不选"
                                                            IsEnabled="{Binding UnrealProjectSync.CanChangeStepSelection, Mode=OneWay}" />
                                                        <Button
                                                            Grid.Column="2"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Click="UnrealSyncInvertSelectionButton_Click"
                                                            Content="反选"
                                                            IsEnabled="{Binding UnrealProjectSync.CanChangeStepSelection, Mode=OneWay}" />
                                                    </Grid>
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Click="UnrealSyncCopyStepReportButton_Click"
                                                            Content="复制清单"
                                                            ToolTipService.ToolTip="把这一步的差异复制成文本" />
                                                        <Button
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Click="UnrealSyncBrowseAssetsButton_Click"
                                                            Content="在 Unreal 中定位"
                                                            ToolTipService.ToolTip="在已打开的编辑器里选中这些资产" />
                                                    </Grid>
                                                </StackPanel>
                                                 <StackPanel Spacing="10" Visibility="{Binding UnrealProjectSync.WorkflowConfirmationVisibility, Mode=OneWay}">
                                                     <TextBlock FontWeight="SemiBold" Text="{Binding UnrealProjectSync.PublishActionText, Mode=OneWay}" />
                                                     <ComboBox ItemsSource="{Binding UnrealProjectSync.PublishFilterOptions, Mode=OneWay}" SelectedItem="{Binding UnrealProjectSync.PublishFilter, Mode=TwoWay}" />
                                                     <TextBlock FontWeight="SemiBold" Text="本次选择" />
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding UnrealProjectSync.ImportSelectionCountText, Mode=OneWay}" />
                                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding UnrealProjectSync.ImportAddedCountText, Mode=OneWay}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding UnrealProjectSync.ImportUpdatedCountText, Mode=OneWay}" />
                                                      </Grid>
                                                     <Button
                                                         MinHeight="44"
                                                         HorizontalAlignment="Stretch"
                                                         Click="PublishCurrentCharacterAssetsToUnrealButton_Click"
                                                          Content="{Binding UnrealProjectSync.PublishActionText, Mode=OneWay}"
                                                          IsEnabled="{Binding UnrealProjectSync.CanStartPublish, Mode=OneWay}"
                                                         Style="{StaticResource AccentButtonStyle}" />
                                                 </StackPanel>
                                                 <StackPanel Spacing="8" Visibility="{Binding UnrealProjectSync.BlueprintSetupDetailsVisibility, Mode=OneWay}">
                                                     <TextBlock FontSize="16" FontWeight="SemiBold" Text="蓝图置入" />
                                                     <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.BlueprintSetupSummaryText, Mode=OneWay}" TextWrapping="Wrap" />
                                                     <Button
                                                         HorizontalAlignment="Stretch"
                                                         HorizontalContentAlignment="Center"
                                                         Click="ApplyUnrealBlueprintSetupButton_Click"
                                                         Content="写入蓝图数据"
                                                         IsEnabled="{Binding UnrealProjectSync.CanApplyBlueprintSetup, Mode=OneWay}"
                                                         Style="{StaticResource AccentButtonStyle}" />
                                                     <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.BlueprintSetupResultMessage, Mode=OneWay}" TextWrapping="Wrap" />
                                                 </StackPanel>
                                                 <StackPanel Spacing="8" Visibility="{Binding UnrealProjectSync.LightConfigurationDetailsVisibility, Mode=OneWay}">
                                                     <TextBlock FontWeight="SemiBold" Text="基础配置" />
                                                     <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding UnrealProjectSync.LightConfigurationSummaryText, Mode=OneWay}" TextWrapping="Wrap" />
                                                     <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding UnrealProjectSync.LightConfigurationSelectionText, Mode=OneWay}" />
                                                     <Button
                                                         MinHeight="44"
                                                         HorizontalAlignment="Stretch"

                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate                                     >
                                                        <Border
                                                            Width="310"
                                                            Margin="0,0,10,10"
                                                            Padding="10"
                                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="76" />
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="88" />
                                                                    <ColumnDefinition Width="40" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="SemiBold"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    Text="{Binding DisplayName, Mode=OneWay}" />
                                                                <Button
                                                                    Grid.Column="1"
                                                                    Click="DecreaseStatButton_Click"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource IconToolButtonStyle}">
                                                                    <SymbolIcon Symbol="Back" />
                                                                </Button>
                                                                <NumberBox
                                                                    Grid.Column="2"
                                                                    Width="88"
                                                                    HorizontalAlignment="Center"
                                                                    KeyDown="StatNumberBox_KeyDown"
                                                                    LostFocus="StatNumberBox_LostFocus"
                                                                    Minimum="0"
                                                                    SmallChange="1"
                                                                    SpinButtonPlacementMode="Hidden"
                                                                    Value="{Binding Value, Mode=OneWay}" />
                                                                <Button
                                                                    Grid.Column="3"
                                                                    Click="IncreaseStatButton_Click"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource IconToolButtonStyle}">
                                                                    <SymbolIcon Symbol="Forward" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="12">
                                    <ItemsControl ItemsSource="{Binding UnrealSync.MaterialSections, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate                                       >
                                                <Border Margin="0,0,0,12" Style="{StaticResource PanelBorderStyle}">
                                                    <Grid Padding="16" RowSpacing="12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Spec.DisplayName, Mode=OneWay}" />
                                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding StatusText, Mode=OneWay}" />
                                                        </StackPanel>
                                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items, Mode=OneWay}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate                                    >
                                                                    <Border
                                                                        Width="154"
                                                                        Margin="0,0,8,8"
                                                                        Padding="8"
                                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6">
                                                                        <StackPanel Spacing="6">
                                                                            <Grid Height="110" Background="{ThemeResource LayerFillColorAltBrush}">
                                                                                <Image Source="{Binding FileUri, Mode=OneWay}" Stretch="Uniform" />
                                                                            </Grid>
                                                                            <TextBlock FontWeight="SemiBold" Text="{Binding FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="SkillsPage"
                    Grid.Row="0"
                    Background="Transparent"
                    RightTapped="PageBlankArea_RightTapped"
                    Tapped="SkillsBlankArea_Tapped"
                    Visibility="Collapsed">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button
                            x:Name="SkillsFocusSink"
                            Width="1"
                            Height="1"
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            IsTabStop="True"
                            Opacity="0" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="St4-技能" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding CharacterDesk.CurrentCharacterStatusText, Mode=OneWay}" />
                                <InfoBar
                                    IsClosable="False"
                                    IsOpen="{Binding CharacterDesk.IsViewOnly, Mode=OneWay}"
                                    Message="当前页面仅供查看，不能修改角色内容。"
                                    Severity="Informational"
                                    Title="查看角色中" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding Skills.StatusText, Mode=OneWay}" />
                        </Grid>
                        <InfoBar
                            Grid.Row="1"
                            IsOpen="{Binding Skills.IsNoticeOpen, Mode=OneWay}"
                            Message="{Binding Skills.NoticeMessage, Mode=OneWay}"
                            Severity="{Binding Skills.NoticeSeverity, Mode=OneWay}"
                            Title="{Binding Skills.NoticeTitle, Mode=OneWay}" />
                        <ScrollViewer
                            x:Name="SkillsScrollViewer"
                            Grid.Row="2"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                Background="Transparent"
                                IsHitTestVisible="{Binding CharacterDesk.CanEditCurrentCharacter, Mode=OneWay}"
                                Spacing="12"
                                Tapped="SkillsBlankArea_Tapped">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelBorderStyle}">
                                    <Grid Padding="16" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="一技能" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="右键技能图标展开详情" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Skills.FirstSkill, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate                                       >
                                                    <local:SkillEditorControl
                                                        DeleteRequested="SkillEditor_DeleteRequested"
                                                        Edited="SkillEditor_Edited"
                                                        FocusReleaseRequested="SkillEditor_FocusReleaseRequested"
                                                        IconSelectionRequested="SkillEditor_IconSelectionRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                                    <Grid Padding="16" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="二技能" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="右键技能图标展开详情" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Skills.SecondSkill, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate                                       >
                                                    <local:SkillEditorControl
                                                        DeleteRequested="SkillEditor_DeleteRequested"
                                                        Edited="SkillEditor_Edited"
                                                        FocusReleaseRequested="SkillEditor_FocusReleaseRequested"
                                                        IconSelectionRequested="SkillEditor_IconSelectionRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelBorderStyle}">
                                    <Grid Padding="16" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="终结技" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="右键技能图标展开详情" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Skills.UltimateSkill, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate                                       >
                                                    <local:SkillEditorControl
                                                        DeleteRequested="SkillEditor_DeleteRequested"
                                                        Edited="SkillEditor_Edited"
                                                        FocusReleaseRequested="SkillEditor_FocusReleaseRequested"
                                                        IconSelectionRequested="SkillEditor_IconSelectionRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                                    <Grid Padding="16" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="护援技" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="右键技能图标展开详情" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                CommandParameter="{Binding Skills.SupportSkill}"
                                                Click="AddSkillStageButton_Click"
                                                Style="{StaticResource IconToolButtonStyle}">
                                                <SymbolIcon Symbol="Add" />
                                            </Button>
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Skills.SupportSkill, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate                                       >
                                                    <local:SkillEditorControl
                                                        DeleteRequested="SkillEditor_DeleteRequested"
                                                        Edited="SkillEditor_Edited"
                                                        FocusReleaseRequested="SkillEditor_FocusReleaseRequested"
                                                        IconSelectionRequested="SkillEditor_IconSelectionRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource PanelBorderStyle}">
                                    <Grid Padding="16" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="连携技" />
                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="右键技能图标展开详情" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                CommandParameter="{Binding Skills.ComboSkills}"
                                                Click="AddSkillStageButton_Click"
                                                Style="{StaticResource IconToolButtonStyle}">
                                                <SymbolIcon Symbol="Add" />
                                            </Button>
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Skills.ComboSkills, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate                                       >
                                                    <local:SkillEditorControl
                                                        DeleteRequested="SkillEditor_DeleteRequested"
                                                        Edited="SkillEditor_Edited"
                                                        FocusReleaseRequested="SkillEditor_FocusReleaseRequested"
                                                        IconSelectionRequested="SkillEditor_IconSelectionRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="SequenceFramesPage"
                    Grid.Row="0"
                    Background="Transparent"
                    RightTapped="PageBlankArea_RightTapped"
                    Visibility="Collapsed">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="St5-序列帧" />
                                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="{Binding CharacterDesk.CurrentCharacterStatusText, Mode=OneWay}" />
                                <InfoBar
                                    IsClosable="False"
                                    IsOpen="{Binding CharacterDesk.IsViewOnly, Mode=OneWay}"
                                    Message="当前页面仅供查看，不能修改角色内容。"
                                    Severity="Informational"
                                    Title="查看角色中" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource SubtleTextStyle}"
                                Text="{Binding SequenceFrames.StatusText, Mode=OneWay}" />
                        </Grid>

                        <InfoBar
                            Grid.Row="1"
                            IsOpen="{Binding SequenceFrames.IsNoticeOpen, Mode=OneWay}"
                            Message="{Binding SequenceFrames.NoticeMessage, Mode=OneWay}"
                            Severity="{Binding SequenceFrames.NoticeSeverity, Mode=OneWay}"
                            Title="{Binding SequenceFrames.NoticeTitle, Mode=OneWay}" />

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="760" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer
                                x:Name="SequenceFramesScrollViewer"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12" IsHitTestVisible="{Binding CharacterDesk.CanEditCurrentCharacter, Mode=OneWay}">
                                    <ItemsControl
                                        ItemTemplate="{StaticResource SequenceFrameSectionGroupTemplate}"
                                        ItemsSource="{Binding SequenceFrames.BaseSectionGroups, Mode=OneWay}" />

                                    <ItemsControl
                                        ItemTemplate="{StaticResource SequenceFrameSectionGroupTemplate}"
                                        ItemsSource="{Binding SequenceFrames.SkillSectionGroups, Mode=OneWay}" />

                                    <Border Style="{StaticResource PanelBorderStyle}">
                                        <Grid Padding="16" RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="连携技板块" />
                                                <TextBlock
                                                    Style="{StaticResource SubtleTextStyle}"
                                                    Text="连携技序列帧只跟随 St4 连携技数量生成。" />
                                            </StackPanel>
                                            <ItemsControl
                                                Grid.Row="1"
                                                ItemTemplate="{StaticResource SequenceFrameSectionTemplate}"
                                                ItemsSource="{Binding SequenceFrames.ComboSections, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid
                                                            ItemWidth="350"
                                                            Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                                <Grid Padding="16" RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="序列帧预览器" />
                                        <TextBlock
                                            Style="{StaticResource SubtleTextStyle}"
                                            Text="{Binding SequenceFrames.PreviewTitle, Mode=OneWay}" />
                                    </StackPanel>
                                    <Grid
                                        x:Name="SequencePreviewCanvas"
                                        Grid.Row="1"
                                        MinHeight="260"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        DoubleTapped="SequencePreviewCanvas_DoubleTapped"
                                        PointerCanceled="SequencePreviewCanvas_PointerCanceled"
                                        PointerCaptureLost="SequencePreviewCanvas_PointerCaptureLost"
                                        PointerMoved="SequencePreviewCanvas_PointerMoved"
                                        PointerPressed="SequencePreviewCanvas_PointerPressed"
                                        PointerReleased="SequencePreviewCanvas_PointerReleased"
                                        PointerWheelChanged="SequencePreviewCanvas_PointerWheelChanged">
                                        <controls:BufferedImagePresenter
                                            x:Name="SequencePreviewPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                            <controls:BufferedImagePresenter.RenderTransform>
                                                <CompositeTransform x:Name="SequencePreviewImageTransform" />
                                            </controls:BufferedImagePresenter.RenderTransform>
                                        </controls:BufferedImagePresenter>
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource SubtleTextStyle}"
                                        Text="{Binding SequenceFrames.CurrentFrameText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Grid Grid.Row="3" ColumnSpacing="8" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="帧速率" />

                        Stroke="#22008F8D"
                        StrokeThickness="7" />
                    <Path
                        x:Name="GlobalProgressRingPath"
                        Stroke="#008F8D"
                        StrokeThickness="7"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                    <TextBlock
                        x:Name="GlobalProgressPercentText"
                        Foreground="#008F8D"
                        FontSize="24"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        LineHeight="28"
                        Text="{Binding GlobalProgress.PercentText, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>


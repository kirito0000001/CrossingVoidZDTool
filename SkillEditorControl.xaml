<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CrossingVoidZDTool.SkillEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CrossingVoidZDTool"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DataContextChanged="SkillEditorControl_DataContextChanged"
    Loaded="SkillEditorControl_Loaded"
    mc:Ignorable="d">
    <Border
        Margin="0,0,10,12"
        Padding="12"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6"
        KeyDown="SkillEditorCard_KeyDown"
        Tapped="SkillEditorCard_Tapped">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Width="86"
                    Height="86"
                    Padding="0"
                    Click="IconToggleButton_Click"
                    RightTapped="IconButton_RightTapped"
                    ToolTipService.ToolTip="左键从 St2 技能图标中选择，右键展开或收起详情">
                    <Grid>
                        <Border
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            CornerRadius="4">
                            <Image
                                Margin="8"
                                Source="{Binding IconUri, Mode=OneWay}"
                                Stretch="Uniform"
                                Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Text="图标"
                            Visibility="{Binding HasNoIcon, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                </Button>

                <Grid
                    Grid.Column="1"
                    ColumnSpacing="10"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="128" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBox
                            x:Name="PositionNameTextBox"
                            MinWidth="0"
                            Header="定位名称"
                            KeyDown="SkillEditorInput_KeyDown"
                            Tag="PositionName"
                            TextChanged="SkillEditorField_TextChanged"
                            Text="{Binding PositionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            x:Name="TrueNameTextBox"
                            MinWidth="0"
                            Header="技能真名"
                            KeyDown="SkillEditorInput_KeyDown"
                            Tag="TrueName"
                            TextChanged="SkillEditorField_TextChanged"
                            Text="{Binding TrueName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBox
                            x:Name="PtCostTextBox"
                            MinWidth="0"
                            Header="Pt消耗"
                            KeyDown="SkillEditorInput_KeyDown"
                            Tag="PtCost"
                            TextChanged="SkillEditorField_TextChanged"
                            Text="{Binding PtCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            x:Name="AttackCapacityTextBox"
                            MinWidth="0"
                            Header="攻击容量"
                            KeyDown="SkillEditorInput_KeyDown"
                            Tag="AttackCapacity"
                            TextChanged="SkillEditorField_TextChanged"
                            Text="{Binding AttackCapacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{Binding ComboCharacterDisplayText, Mode=OneWay}"
                        Visibility="{Binding HasComboCharacter, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                </Grid>

                <Button
                    Grid.Column="2"
                    Margin="0,28,0,0"
                    VerticalAlignment="Top"
                    Click="DeleteStageButton_Click"
                    Style="{StaticResource IconToolButtonStyle}"
                    ToolTipService.ToolTip="删除这个技能阶段"
                    Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </Grid>

            <Grid
                Grid.Row="1"
                RowSpacing="12"
                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="DescriptionTextBox"
                    MinHeight="118"
                    AcceptsReturn="True"
                    Header="介绍"
                    KeyDown="SkillEditorInput_KeyDown"
                    Tag="Description"
                    TextChanged="SkillEditorField_TextChanged"
                    Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12">
                        <ComboBox
                            x:Name="SkillStateComboBox"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Header="技能状态"
                            KeyDown="SkillEditorInput_KeyDown"
                            Tag="SkillState"
                            SelectionChanged="SkillEditorField_SelectionChanged"
                            SelectedValue="{Binding SkillState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="空" Tag="空" />
                            <ComboBoxItem Content="常态" Tag="常态" />
                            <ComboBoxItem Content="禁用" Tag="禁用" />
                            <ComboBoxItem Content="舍弃" Tag="舍弃" />
                        </ComboBox>
                        <ComboBox
                            x:Name="GuardStateComboBox"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Header="守备"
                            KeyDown="SkillEditorInput_KeyDown"
                            Tag="GuardState"
                            SelectionChanged="SkillEditorField_SelectionChanged"
                            SelectedValue="{Binding GuardState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="空" Tag="空" />
                            <ComboBoxItem Content="防御" Tag="防御" />
                            <ComboBoxItem Content="反击" Tag="反击" />
                            <ComboBoxItem Content="闪避" Tag="闪避" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBox
                            x:Name="GuardValueTextBox"
                            MinWidth="0"
                            Header="守备数值"
                            KeyDown="SkillEditorInput_KeyDown"
                            Tag="GuardValue"
                            TextChanged="SkillEditorField_TextChanged"
                            Text="{Binding GuardValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            x:Name="AutoPriorityTextBox"
                            MinWidth="0"
                            Header="自动优先级 0-100"
                            KeyDown="SkillEditorInput_KeyDown"
                            Tag="AutoPriority"
                            TextChanged="SkillEditorField_TextChanged"
                            Text="{Binding AutoPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="2"
                    Padding="10"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="等级" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="物理倍率" />
                            <TextBlock
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="异能倍率" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding LevelMultipliers, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SkillMultiplierLevel">
                                    <Grid
                                        Margin="0,0,0,6"
                                    ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Height="34"
                                            MinWidth="42"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{Binding Level, Mode=OneWay}" />
                                        </Border>
                                        <TextBox
                                            Grid.Column="1"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            KeyDown="SkillEditorInput_KeyDown"
                                            Tag="PhysicalMultiplier"
                                            TextChanged="SkillEditorField_TextChanged"
                                            Text="{Binding PhysicalMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Grid.Column="2"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            KeyDown="SkillEditorInput_KeyDown"
                                            Tag="EnergyMultiplier"
                                            TextChanged="SkillEditorField_TextChanged"
                                            Text="{Binding EnergyMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
